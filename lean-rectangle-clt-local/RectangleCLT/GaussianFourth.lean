import RectangleCLT.ExponentialRescaling
import RectangleCLT.ExponentialMixture

/-! Fourth-coordinate Gaussian face estimates. The actual exponential-law
rescaling primitives are proved in `ExponentialRescaling`. -/

open MeasureTheory ProbabilityTheory
open scoped BigOperators ENNReal

namespace RectangleCLT

noncomputable section

/-- Logarithmic face offsets generated by one null exponential and the face
exponentials. The null coordinate is indexed by `none`. -/
def exponentialThresholds {ι : Type*} (h : ℝ) (b : ι → ℝ)
    (E : Option ι → ℝ) : ι → ℝ :=
  fun i => b i + h * Real.log (E (some i) / E none)

private def faceRescalingCost {ι : Type*} (S : Finset ι) (d : ι → ℝ)
    (r h : ℝ) : Option ι → ℝ := by
  classical
  exact fun i => match i with
    | none => r / h
    | some j => if j ∈ S then (r - d j) / h else 0

private theorem faceRescalingCost_nonneg {ι : Type*} (S : Finset ι) (d : ι → ℝ)
    {r h : ℝ} (hr : 0 ≤ r) (hh : 0 < h) (hd : ∀ i, d i ≤ r) (i : Option ι) :
    0 ≤ faceRescalingCost S d r h i := by
  classical
  cases i with
  | none => exact div_nonneg hr hh.le
  | some i =>
    by_cases hi : i ∈ S
    · simp only [faceRescalingCost, hi, if_true]
      exact div_nonneg (sub_nonneg.mpr (hd i)) hh.le
    · simp [faceRescalingCost, hi]

private theorem sum_faceRescalingCost_le {ι : Type*} [Fintype ι]
    (S : Finset ι) (d : ι → ℝ) {r h : ℝ} (hh : 0 < h)
    (hd : ∀ i, -r ≤ d i) :
    (∑ i, faceRescalingCost S d r h i) ≤
      (1 + 2 * (S.card : ℝ)) * r / h := by
  classical
  simp only [Fintype.sum_option, faceRescalingCost]
  rw [Finset.sum_ite_mem, Finset.univ_inter]
  calc
    _ ≤ r / h + ∑ _i ∈ S, 2 * r / h := by
      apply add_le_add_left
      apply Finset.sum_le_sum
      intro i _
      exact div_le_div_of_nonneg_right (by linarith [hd i]) hh.le
    _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul]; ring

private theorem rescaling_density_factor_le {ι : Type*} [Fintype ι]
    (S : Finset ι) (d : ι → ℝ) {r h : ℝ} (hh : 0 < h)
    (hd : ∀ i, -r ≤ d i) :
    (∏ i : Option ι, ENNReal.ofReal (Real.exp (-faceRescalingCost S d r h i))⁻¹) ≤
      ENNReal.ofReal (Real.exp ((1 + 2 * (S.card : ℝ)) * r / h)) := by
  have hexp (i : Option ι) : (Real.exp (-faceRescalingCost S d r h i))⁻¹ =
      Real.exp (faceRescalingCost S d r h i) := by rw [Real.exp_neg, inv_inv]
  simp_rw [hexp]
  rw [← ENNReal.ofReal_prod_of_nonneg (fun i _ => (Real.exp_pos _).le), ← Real.exp_sum]
  exact ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr (sum_faceRescalingCost_le S d hh hd))

private theorem exponentialThresholds_rescale {ι : Type*} [DecidableEq ι]
    (S : Finset ι) (d b : ι → ℝ) {r h : ℝ} (hh : 0 < h)
    (E : Option ι → ℝ) (hE : ∀ i, 0 < E i) (i : ι) :
    exponentialThresholds h b
      (fun j => Real.exp (-faceRescalingCost S d r h j) * E j) i =
        exponentialThresholds h b E i + (if i ∈ S then d i else r) := by
  classical
  unfold exponentialThresholds
  rw [Real.log_div (mul_ne_zero (Real.exp_ne_zero _) (ne_of_gt (hE (some i))))
      (mul_ne_zero (Real.exp_ne_zero _) (ne_of_gt (hE none))),
    Real.log_mul (Real.exp_ne_zero _) (ne_of_gt (hE (some i))),
    Real.log_mul (Real.exp_ne_zero _) (ne_of_gt (hE none)),
    Real.log_div (ne_of_gt (hE (some i))) (ne_of_gt (hE none)),
    Real.log_exp, Real.log_exp]
  by_cases hi : i ∈ S <;> simp only [faceRescalingCost, hi, if_true, if_false] <;>
    field_simp [ne_of_gt hh] <;> ring

/-- The manuscript's exponential-mixture local domination, proved for the
actual independent exponential law. Active thresholds may behave arbitrarily;
only monotonicity in the inactive thresholds is required. The cost depends on
the number of active faces, not on the ambient number of faces. -/
theorem exponentialThreshold_local_domination {ι : Type*} [Fintype ι]
    (S : Finset ι) (b d : ι → ℝ) {r h : ℝ} (hr : 0 ≤ r) (hh : 0 < h)
    (hd : ∀ i, -r ≤ d i ∧ d i ≤ r)
    (H : (ι → ℝ) → ℝ≥0∞) (hH : Measurable H)
    (hmono : ∀ x y : ι → ℝ, (∀ i ∈ S, x i = y i) →
      (∀ i, i ∉ S → x i ≤ y i) → H x ≤ H y) :
    (∫⁻ E, H (fun i => exponentialThresholds h b E i + d i)
      ∂Measure.pi (fun _ : Option ι => unitExponential)) ≤
      ENNReal.ofReal (Real.exp ((1 + 2 * (S.card : ℝ)) * r / h)) *
        ∫⁻ E, H (exponentialThresholds h b E)
          ∂Measure.pi (fun _ : Option ι => unitExponential) := by
  classical
  let a : Option ι → ℝ := fun i => Real.exp (-faceRescalingCost S d r h i)
  have ha (i : Option ι) : 0 < a i := Real.exp_pos _
  have haone (i : Option ι) : a i ≤ 1 := Real.exp_le_one_iff.mpr
    (neg_nonpos.mpr (faceRescalingCost_nonneg S d hr hh (fun i => (hd i).2) i))
  have hthresholds : Measurable (exponentialThresholds h b) := by
    exact measurable_pi_lambda _ (fun i => measurable_const.add
      (((measurable_pi_apply (some i)).div (measurable_pi_apply none)).log.const_mul h))
  have hpositive : ∀ᵐ E ∂Measure.pi (fun _ : Option ι => unitExponential), ∀ i, 0 < E i := by
    apply ae_all_iff.mpr
    intro i
    exact Measure.tendsto_eval_ae_ae.eventually unitExponential_ae_pos
  calc
    _ ≤ ∫⁻ E, H (exponentialThresholds h b (fun i => a i * E i))
        ∂Measure.pi (fun _ : Option ι => unitExponential) := by
      apply lintegral_mono_ae
      filter_upwards [hpositive] with E hE
      apply hmono
      · intro i hi
        rw [exponentialThresholds_rescale S d b hh E hE i]
        simp [hi]
      · intro i hi
        rw [exponentialThresholds_rescale S d b hh E hE i]
        simp only [hi, if_false]
        exact add_le_add_left (hd i).2 _
    _ ≤ (∏ i, ENNReal.ofReal (a i)⁻¹) *
        ∫⁻ E, H (exponentialThresholds h b E)
          ∂Measure.pi (fun _ : Option ι => unitExponential) :=
      unitExponential_pi_lintegral_scale_le a ha haone _ (hH.comp hthresholds)
    _ ≤ _ := mul_le_mul_right' (rescaling_density_factor_le S d hh (fun i => (hd i).1)) _

end
end RectangleCLT
