import RectangleCLT.LocalOptimization

/-!
# The companion paper's bandwidth calculation

These are scalar optimization lemmas, independent of any probabilistic or
Gaussian derivative estimate. They do not assert the companion CLT.
-/

namespace RectangleCLT.Companion

noncomputable section

/-- Logarithm generated by integration after the switching time `L * h²`. -/
def comparisonLog (L h : ℝ) : ℝ := max 0 (Real.log (1 / (L * h ^ 2)))

/-- The admissible bandwidth in Appendix D, with its logarithmic factor
supplied separately to keep this scalar lemma independent of the model. -/
def optimalBandwidth (A δ L κ E : ℝ) : ℝ :=
  A * δ * Real.sqrt (L * E / κ)

theorem optimalBandwidth_pos {A δ L κ E : ℝ}
    (hA : 0 < A) (hδ : 0 < δ) (hL : 0 < L) (hκ : 0 < κ) (hE : 0 < E) :
    0 < optimalBandwidth A δ L κ E :=
  mul_pos (mul_pos hA hδ) (Real.sqrt_pos.mpr (div_pos (mul_pos hL hE) hκ))

theorem optimalBandwidth_admissible {A δ L κ E : ℝ}
    (hA : 0 ≤ A) (hδ : 0 ≤ δ) (hκ : 0 < κ) (hκL : κ ≤ L) (hE : 1 ≤ E) :
    A * δ ≤ optimalBandwidth A δ L κ E := by
  have hL : 0 < L := hκ.trans_le hκL
  have hratio : 1 ≤ L * E / κ := by
    apply (le_div_iff₀ hκ).mpr
    nlinarith [mul_le_mul_of_nonneg_left hE hL.le]
  have hs : 1 ≤ Real.sqrt (L * E / κ) := by
    simpa using Real.sqrt_le_sqrt hratio
  exact le_mul_of_one_le_right (mul_nonneg hA hδ) hs

theorem comparisonLog_optimalBandwidth_le {A δ L κ E : ℝ}
    (hA : 1 ≤ A) (hδ : 0 < δ) (hL : 0 < L) (hκ : 0 < κ) (hE : 1 ≤ E)
    (hlog : max 0 (Real.log (Real.sqrt κ / (δ * L))) ≤ E) :
    comparisonLog L (optimalBandwidth A δ L κ E) ≤ 2 * E := by
  have hApos : 0 < A := by linarith
  have hEpos : 0 < E := by linarith
  have hh := optimalBandwidth_pos hApos hδ hL hκ hEpos
  have hx : 0 < Real.sqrt κ / (δ * L) :=
    div_pos (Real.sqrt_pos.mpr hκ) (mul_pos hδ hL)
  have hs := Real.sq_sqrt (div_pos (mul_pos hL hEpos) hκ).le
  have hκsq := Real.sq_sqrt hκ.le
  have hA2 : 1 ≤ A ^ 2 := by nlinarith
  have hprod : 1 ≤ A ^ 2 * E := by nlinarith
  have hcompare : 1 / (L * (optimalBandwidth A δ L κ E) ^ 2) ≤
      (Real.sqrt κ / (δ * L)) ^ 2 := by
    apply (div_le_iff₀ (mul_pos hL (sq_pos_of_pos hh))).mpr
    dsimp only [optimalBandwidth]
    have heq : (Real.sqrt κ / (δ * L)) ^ 2 *
        (L * (A * δ * Real.sqrt (L * E / κ)) ^ 2) = A ^ 2 * E := by
      rw [div_pow, mul_pow, mul_pow, mul_pow, hκsq, hs]
      field_simp
      ring
    rw [heq]
    exact hprod
  have hlogcompare := Real.log_le_log
    (div_pos zero_lt_one (mul_pos hL (sq_pos_of_pos hh))) hcompare
  rw [Real.log_pow] at hlogcompare
  have hxlog : Real.log (Real.sqrt κ / (δ * L)) ≤ E :=
    (le_max_right _ _).trans hlog
  unfold comparisonLog
  exact max_le (by linarith) (by linarith)

/-- The two terms involving the bandwidth are exactly balanced, apart from
the supplied logarithmic bound. -/
theorem bandwidth_error_le {A δ L κ E q : ℝ}
    (hA : 1 ≤ A) (hδ : 0 < δ) (hL : 0 < L) (hκ : 0 < κ) (hE : 1 ≤ E)
    (hq : q ≤ 3 * E) :
    δ ^ 2 * (L * Real.sqrt L) / optimalBandwidth A δ L κ E * q +
        optimalBandwidth A δ L κ E * Real.sqrt L * κ ≤
      (A + 3 / A) * (δ * L * Real.sqrt (κ * E)) := by
  have hApos : 0 < A := by linarith
  have hEpos : 0 < E := by linarith
  have hh := optimalBandwidth_pos hApos hδ hL hκ hEpos
  have hsL := Real.sq_sqrt hL.le
  have hsκ := Real.sq_sqrt hκ.le
  have hsE := Real.sq_sqrt hEpos.le
  have hsl : 0 < Real.sqrt L := Real.sqrt_pos.mpr hL
  have hsk : 0 < Real.sqrt κ := Real.sqrt_pos.mpr hκ
  have hse : 0 < Real.sqrt E := Real.sqrt_pos.mpr hEpos
  have hsqrt : Real.sqrt (L * E / κ) = Real.sqrt L * Real.sqrt E / Real.sqrt κ := by
    rw [Real.sqrt_div (mul_nonneg hL.le hEpos.le), Real.sqrt_mul hL.le]
  have hroot : Real.sqrt (κ * E) = Real.sqrt κ * Real.sqrt E := Real.sqrt_mul hκ.le E
  have hend : optimalBandwidth A δ L κ E * Real.sqrt L * κ =
      A * (δ * L * Real.sqrt (κ * E)) := by
    rw [optimalBandwidth, hsqrt, hroot]
    field_simp
    linear_combination A * δ * Real.sqrt E * κ * hsL -
      A * δ * L * Real.sqrt E * hsκ
  have hbal : δ ^ 2 * (L * Real.sqrt L) / optimalBandwidth A δ L κ E * (3 * E) =
      (3 / A) * (δ * L * Real.sqrt (κ * E)) := by
    rw [optimalBandwidth, hsqrt, hroot]
    field_simp
    linear_combination -3 * A * δ ^ 2 * L * Real.sqrt L * Real.sqrt κ * hsE
  have hc : 0 ≤ δ ^ 2 * (L * Real.sqrt L) / optimalBandwidth A δ L κ E :=
    div_nonneg (mul_nonneg (sq_nonneg _) (mul_nonneg hL.le hsl.le)) hh.le
  calc
    _ ≤ δ ^ 2 * (L * Real.sqrt L) / optimalBandwidth A δ L κ E * (3 * E) +
        optimalBandwidth A δ L κ E * Real.sqrt L * κ := by gcongr
    _ = _ := by rw [hend, hbal]; ring

/-- Conditional scalar final step for the zero-skewness variational bound.
The estimate `hmaster` is an explicit assumption, not a proved analytic input. -/
theorem zeroSkew_rate_of_variational {A C δ L κ E error : ℝ}
    (hA : 1 ≤ A) (hC : 0 ≤ C) (hδ : 0 < δ) (hL : 0 < L)
    (hκ : 0 < κ) (hκL : κ ≤ L) (hE : 1 ≤ E)
    (hlog : max 0 (Real.log (Real.sqrt κ / (δ * L))) ≤ E)
    (hmaster : ∀ h : ℝ, A * δ ≤ h → error ≤ C *
      (δ ^ 2 * (L * Real.sqrt L) / h * (1 + comparisonLog L h) + h * Real.sqrt L * κ)) :
    error ≤ C * (A + 3 / A) * (δ * L * Real.sqrt (κ * E)) := by
  have hband := optimalBandwidth_admissible (by linarith : 0 ≤ A) hδ.le hκ hκL hE
  have hq : 1 + comparisonLog L (optimalBandwidth A δ L κ E) ≤ 3 * E := by
    have := comparisonLog_optimalBandwidth_le hA hδ hL hκ hE hlog
    linarith
  exact (hmaster _ hband).trans (by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left
      (bandwidth_error_le hA hδ hL hκ hE hq) hC)

/-- The general variational estimate adds the bandwidth-independent cubic
term. It remains conditional on that variational estimate. -/
theorem gap_rate_of_variational {A C δ L κ E error : ℝ}
    (hA : 1 ≤ A) (hC : 0 ≤ C) (hδ : 0 < δ) (hL : 0 < L)
    (hκ : 0 < κ) (hκL : κ ≤ L) (hE : 1 ≤ E)
    (hlog : max 0 (Real.log (Real.sqrt κ / (δ * L))) ≤ E)
    (hmaster : ∀ h : ℝ, A * δ ≤ h → error ≤ C *
      (δ * L * Real.sqrt L +
        δ ^ 2 * (L * Real.sqrt L) / h * comparisonLog L h + h * Real.sqrt L * κ)) :
    error ≤ C * (δ * L * Real.sqrt L +
      (A + 3 / A) * (δ * L * Real.sqrt (κ * E))) := by
  have hband := optimalBandwidth_admissible (by linarith : 0 ≤ A) hδ.le hκ hκL hE
  have hq : comparisonLog L (optimalBandwidth A δ L κ E) ≤ 3 * E := by
    have := comparisonLog_optimalBandwidth_le hA hδ hL hκ hE hlog
    linarith
  apply (hmaster _ hband).trans
  apply mul_le_mul_of_nonneg_left _ hC
  have := bandwidth_error_le hA hδ hL hκ hE hq
  linarith

end

end RectangleCLT.Companion
