import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic
import Mathlib.MeasureTheory.Integral.Prod
import Mathlib.MeasureTheory.Constructions.Pi
import RectangleCLTCompanion.SplitV4.PairedSlepian

/-!
Conditional expectations on the actual independent-copy product experiment.
The original sigma-field is the pullback under the first projection, and
copy averages are genuine Bochner integrals. No conditional coefficient or
desired comparison estimate is introduced as a postulate.
-/

open MeasureTheory Set
open scoped BigOperators

namespace RectangleCLT.Companion.SplitV4

noncomputable section

set_option autoImplicit false

/-- The sigma-field generated by the whole original sample on a product
of that sample with its independent copy. -/
def originalSigma {α β : Type*} [mα : MeasurableSpace α] [MeasurableSpace β] :
    MeasurableSpace (α × β) := mα.comap Prod.fst

theorem originalSigma_le {α β : Type*} [MeasurableSpace α] [MeasurableSpace β] :
    originalSigma (α := α) (β := β) ≤ (inferInstance : MeasurableSpace (α × β)) :=
  measurable_fst.comap_le

/-- Averaging over the independent copy while holding the original fixed. -/
def copyAverage {α β E : Type*} [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ν : Measure β) (f : α × β → E) (x : α) : E :=
  ∫ y, f (x, y) ∂ν

/-- Fubini's copy integral is the actual conditional expectation given
the whole original sample. The integrability premise is genuine Bochner
integrability; no estimate is assumed. -/
theorem copyAverage_ae_eq_condExp
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (μ : Measure α) [IsProbabilityMeasure μ]
    (ν : Measure β) [IsProbabilityMeasure ν]
    (f : α × β → E) (hfm : StronglyMeasurable f) (hfi : Integrable f (μ.prod ν)) :
    (fun z : α × β => copyAverage ν f z.1) =ᵐ[μ.prod ν]
      (μ.prod ν)[f | originalSigma] := by
  have hmp : MeasurePreserving (Prod.fst : α × β → α) (μ.prod ν) μ :=
    ⟨measurable_fst, by simp⟩
  have hgi : Integrable (fun z : α × β => copyAverage ν f z.1) (μ.prod ν) :=
    (hmp.integrable_comp hfi.integral_prod_left.aestronglyMeasurable).mpr hfi.integral_prod_left
  apply ae_eq_condExp_of_forall_setIntegral_eq originalSigma_le hfi
  · intro s _ _
    exact hgi.integrableOn
  · intro s hs _
    rcases hs with ⟨t, ht, rfl⟩
    have hset : (Prod.fst : α × β → α) ⁻¹' t = t ×ˢ (univ : Set β) := by
      ext z
      simp
    rw [hset, setIntegral_prod _ hgi.integrableOn, setIntegral_prod _ hfi.integrableOn]
    simp only [copyAverage, Measure.restrict_univ, integral_const,
      measureReal_univ_eq_one, one_smul]
  · exact (hfm.integral_prod_right'.comp_measurable (comap_measurable Prod.fst)).aestronglyMeasurable

/-- The actual large-increment mean for one observation and its copy.
Use normalized observations `X/sqrt n` for the increments of Appendix G. -/
def copyLargeIncrementMean {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) (X : Ω → Vector p) (x : Vector p) (h : ℝ) : Vector p :=
  ∫ ω, X ω - x - pairedTruncatedIncrement x (X ω) h ∂μ

/-- The actual half second-moment matrix of one truncated paired increment. -/
def copyTruncatedCovariance {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) (X : Ω → Vector p) (x : Vector p) (h : ℝ) :
    Matrix (Fin p) (Fin p) ℝ :=
  fun j k => (1 / 2 : ℝ) * ∫ ω,
    pairedTruncatedIncrement x (X ω) h j * pairedTruncatedIncrement x (X ω) h k ∂μ

def copyLargeIncrementIntegrand {Ω : Type*} {p : ℕ}
    (X : Ω → Vector p) (h : ℝ) (z : Ω × Ω) : Vector p :=
  X z.2 - X z.1 - pairedTruncatedIncrement (X z.1) (X z.2) h

def copyCovarianceIntegrand {Ω : Type*} {p : ℕ}
    (X : Ω → Vector p) (h : ℝ) (j k : Fin p) (z : Ω × Ω) : ℝ :=
  (1 / 2 : ℝ) * (pairedTruncatedIncrement (X z.1) (X z.2) h j *
    pairedTruncatedIncrement (X z.1) (X z.2) h k)

theorem copyLargeIncrementIntegrand_eq_tail {Ω : Type*} {p : ℕ}
    (X : Ω → Vector p) (h : ℝ) (z : Ω × Ω) :
    copyLargeIncrementIntegrand X h z =
      if h < ‖X z.2 - X z.1‖ then X z.2 - X z.1 else 0 := by
  by_cases he : ‖X z.2 - X z.1‖ ≤ h
  · simp only [copyLargeIncrementIntegrand, pairedTruncatedIncrement, if_pos he,
      sub_self, not_lt.mpr he, if_false]
  · simp only [copyLargeIncrementIntegrand, pairedTruncatedIncrement, if_neg he,
      sub_zero, lt_of_not_ge he, if_true]

theorem measurable_copyLargeIncrementIntegrand
    {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (X : Ω → Vector p) (hX : Measurable X) (h : ℝ) :
    Measurable (copyLargeIncrementIntegrand X h) :=
  ((hX.comp measurable_snd).sub (hX.comp measurable_fst)).sub
    (C4Test.measurable_pairedTruncatedIncrement X hX h)

theorem integrable_copyLargeIncrementIntegrand
    {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → Vector p) (hX : Measurable X) (hXi : Integrable X μ)
    {h : ℝ} (hh : 0 ≤ h) :
    Integrable (copyLargeIncrementIntegrand X h) (μ.prod μ) := by
  have hfst : MeasurePreserving (Prod.fst : Ω × Ω → Ω) (μ.prod μ) μ :=
    ⟨measurable_fst, by simp⟩
  have hsnd : MeasurePreserving (Prod.snd : Ω × Ω → Ω) (μ.prod μ) μ :=
    ⟨measurable_snd, by simp⟩
  have hi₀ : Integrable (fun z : Ω × Ω => X z.1) (μ.prod μ) :=
    (hfst.integrable_comp hXi.aestronglyMeasurable).mpr hXi
  have hi₁ : Integrable (fun z : Ω × Ω => X z.2) (μ.prod μ) :=
    (hsnd.integrable_comp hXi.aestronglyMeasurable).mpr hXi
  have hsmall : Integrable
      (fun z : Ω × Ω => pairedTruncatedIncrement (X z.1) (X z.2) h) (μ.prod μ) := by
    apply (integrable_const h).mono'
      (C4Test.measurable_pairedTruncatedIncrement X hX h).aestronglyMeasurable
    exact ae_of_all _ (fun z => C4Test.norm_pairedTruncatedIncrement_le _ _ hh)
  exact (hi₁.sub hi₀).sub hsmall

theorem measurable_copyCovarianceIntegrand
    {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (X : Ω → Vector p) (hX : Measurable X) (h : ℝ) (j k : Fin p) :
    Measurable (copyCovarianceIntegrand X h j k) := by
  have hm := C4Test.measurable_pairedTruncatedIncrement X hX h
  exact measurable_const.mul (((measurable_pi_apply j).comp hm).mul
    ((measurable_pi_apply k).comp hm))

theorem integrable_copyCovarianceIntegrand
    {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → Vector p) (hX : Measurable X) {h : ℝ} (hh : 0 ≤ h) (j k : Fin p) :
    Integrable (copyCovarianceIntegrand X h j k) (μ.prod μ) := by
  apply (integrable_const ((1 / 2 : ℝ) * h ^ 2)).mono'
    (measurable_copyCovarianceIntegrand X hX h j k).aestronglyMeasurable
  apply ae_of_all
  intro z
  have hb : ‖pairedTruncatedIncrement (X z.1) (X z.2) h‖ ≤ h :=
    C4Test.norm_pairedTruncatedIncrement_le _ _ hh
  have hj : |pairedTruncatedIncrement (X z.1) (X z.2) h j| ≤ h := by
    apply le_trans _ hb
    simpa only [Real.norm_eq_abs] using
      norm_le_pi_norm (pairedTruncatedIncrement (X z.1) (X z.2) h) j
  have hk : |pairedTruncatedIncrement (X z.1) (X z.2) h k| ≤ h := by
    apply le_trans _ hb
    simpa only [Real.norm_eq_abs] using
      norm_le_pi_norm (pairedTruncatedIncrement (X z.1) (X z.2) h) k
  simp only [copyCovarianceIntegrand, Real.norm_eq_abs, abs_mul,
    abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
  apply mul_le_mul_of_nonneg_left _ (by norm_num : (0 : ℝ) ≤ 1 / 2)
  simpa only [pow_two] using mul_le_mul hj hk (abs_nonneg _) hh

/-- The actual one-observation tail copy mean is a version of the
conditional expectation given the complete original sample. -/
theorem copyLargeIncrementMean_ae_eq_condExp
    {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → Vector p) (hX : Measurable X) (hXi : Integrable X μ)
    {h : ℝ} (hh : 0 ≤ h) :
    (fun z : Ω × Ω => copyLargeIncrementMean μ X (X z.1) h) =ᵐ[μ.prod μ]
      (μ.prod μ)[copyLargeIncrementIntegrand X h | originalSigma] := by
  exact copyAverage_ae_eq_condExp μ μ (copyLargeIncrementIntegrand X h)
    (measurable_copyLargeIncrementIntegrand X hX h).stronglyMeasurable
    (integrable_copyLargeIncrementIntegrand μ X hX hXi hh)

/-- Every entry of the actual truncated copy covariance is the
corresponding conditional expectation. Truncation supplies integrability. -/
theorem copyTruncatedCovariance_ae_eq_condExp
    {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → Vector p) (hX : Measurable X) {h : ℝ} (hh : 0 ≤ h) (j k : Fin p) :
    (fun z : Ω × Ω => copyTruncatedCovariance μ X (X z.1) h j k) =ᵐ[μ.prod μ]
      (μ.prod μ)[copyCovarianceIntegrand X h j k | originalSigma] := by
  simpa only [copyAverage, copyTruncatedCovariance, copyCovarianceIntegrand,
    integral_const_mul] using
    copyAverage_ae_eq_condExp μ μ (copyCovarianceIntegrand X h j k)
      (measurable_copyCovarianceIntegrand X hX h j k).stronglyMeasurable
      (integrable_copyCovarianceIntegrand μ X hX hh j k)

/-- Conditional averaging contracts the actual expected norm. This is
Bochner's norm-integral inequality followed by Fubini, not an assumed
conditional Jensen estimate. -/
theorem integral_norm_copyAverage_le
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (μ : Measure α) [IsProbabilityMeasure μ]
    (ν : Measure β) [IsProbabilityMeasure ν]
    (f : α × β → E) (hfi : Integrable f (μ.prod ν)) :
    (∫ x, ‖copyAverage ν f x‖ ∂μ) ≤ ∫ z, ‖f z‖ ∂μ.prod ν := by
  rw [integral_prod _ hfi.norm]
  apply integral_mono hfi.integral_prod_left.norm hfi.integral_norm_prod_left
  intro x
  exact norm_integral_le_integral_norm _

theorem integral_norm_copyAverage_fst_le
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (μ : Measure α) [IsProbabilityMeasure μ]
    (ν : Measure β) [IsProbabilityMeasure ν]
    (f : α × β → E) (hfi : Integrable f (μ.prod ν)) :
    (∫ z : α × β, ‖copyAverage ν f z.1‖ ∂μ.prod ν) ≤ ∫ z, ‖f z‖ ∂μ.prod ν := by
  have heq := integral_fun_fst (μ := μ) (ν := ν) (fun x => ‖copyAverage ν f x‖)
  simp only [measureReal_univ_eq_one, one_smul] at heq
  rw [heq]
  exact integral_norm_copyAverage_le μ ν f hfi

/-- The entire finite-array tail mean, after conditioning on the whole
original sample. Different summands may have different laws. -/
def copyArrayLargeMean {Ω : Type*} [MeasurableSpace Ω] {p n : ℕ}
    (μ : Measure Ω) (ξ : Fin n → Ω → Vector p) (x : Ω) (h : ℝ) : Vector p :=
  ∑ i, copyLargeIncrementMean μ (ξ i) (ξ i x) h

def arrayLargeIncrementIntegrand {Ω : Type*} {p n : ℕ}
    (ξ : Fin n → Ω → Vector p) (h : ℝ) (z : Ω × Ω) : Vector p :=
  ∑ i, copyLargeIncrementIntegrand (ξ i) h z

/-- The entire matrix `T_h`, with its factor one half and both indices. -/
def copyArrayTruncatedCovariance {Ω : Type*} [MeasurableSpace Ω] {p n : ℕ}
    (μ : Measure Ω) (ξ : Fin n → Ω → Vector p) (x : Ω) (h : ℝ) :
    Matrix (Fin p) (Fin p) ℝ :=
  fun j k => ∑ i, copyTruncatedCovariance μ (ξ i) (ξ i x) h j k

def arrayCovarianceIntegrand {Ω : Type*} {p n : ℕ}
    (ξ : Fin n → Ω → Vector p) (h : ℝ) (j k : Fin p) (z : Ω × Ω) : ℝ :=
  ∑ i, copyCovarianceIntegrand (ξ i) h j k z

theorem arrayCovarianceIntegrand_eq_half_sum {Ω : Type*} {p n : ℕ}
    (ξ : Fin n → Ω → Vector p) (h : ℝ) (j k : Fin p) (z : Ω × Ω) :
    arrayCovarianceIntegrand ξ h j k z = (1 / 2 : ℝ) *
      ∑ i, pairedTruncatedIncrement (ξ i z.1) (ξ i z.2) h j *
        pairedTruncatedIncrement (ξ i z.1) (ξ i z.2) h k := by
  simp only [arrayCovarianceIntegrand, copyCovarianceIntegrand, Finset.mul_sum]

/-- The actual whole-array large-increment copy integral equals `b_h` as
a conditional expectation. Summand independence is unnecessary for this
identity; the independent original/copy experiment is the product law. -/
theorem copyArrayLargeMean_ae_eq_condExp
    {Ω : Type*} [MeasurableSpace Ω] {p n : ℕ}
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (ξ : Fin n → Ω → Vector p) (hξ : ∀ i, Measurable (ξ i))
    (hξi : ∀ i, Integrable (ξ i) μ) {h : ℝ} (hh : 0 ≤ h) :
    (fun z : Ω × Ω => copyArrayLargeMean μ ξ z.1 h) =ᵐ[μ.prod μ]
      (μ.prod μ)[arrayLargeIncrementIntegrand ξ h | originalSigma] := by
  have heach (i : Fin n) := copyLargeIncrementMean_ae_eq_condExp μ (ξ i) (hξ i) (hξi i) hh
  have hall := ae_all_iff.mpr heach
  have hs := condExp_finset_sum (s := Finset.univ)
    (f := fun i => copyLargeIncrementIntegrand (ξ i) h)
    (fun i _ => integrable_copyLargeIncrementIntegrand μ (ξ i) (hξ i) (hξi i) hh)
    originalSigma
  have hfun : (∑ i, copyLargeIncrementIntegrand (ξ i) h) = arrayLargeIncrementIntegrand ξ h := by
    funext z
    simp only [Finset.sum_apply, arrayLargeIncrementIntegrand]
  rw [hfun] at hs
  have hsum : (fun z : Ω × Ω => ∑ i, copyLargeIncrementMean μ (ξ i) (ξ i z.1) h) =ᵐ[μ.prod μ]
      fun z => ∑ i, ((μ.prod μ)[copyLargeIncrementIntegrand (ξ i) h | originalSigma]) z := by
    filter_upwards [hall] with z hz
    exact Finset.sum_congr rfl (fun i _ => hz i)
  have hs' : (fun z : Ω × Ω => ∑ i,
      ((μ.prod μ)[copyLargeIncrementIntegrand (ξ i) h | originalSigma]) z) =ᵐ[μ.prod μ]
      (μ.prod μ)[arrayLargeIncrementIntegrand ξ h | originalSigma] := by
    filter_upwards [hs] with z hz
    simpa only [Finset.sum_apply] using hz.symm
  exact hsum.trans hs'

/-- The half summed truncated-copy second moments are exactly the actual
conditional matrix coefficients `T_h`, entry by entry. -/
theorem copyArrayTruncatedCovariance_ae_eq_condExp
    {Ω : Type*} [MeasurableSpace Ω] {p n : ℕ}
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (ξ : Fin n → Ω → Vector p) (hξ : ∀ i, Measurable (ξ i))
    {h : ℝ} (hh : 0 ≤ h) (j k : Fin p) :
    (fun z : Ω × Ω => copyArrayTruncatedCovariance μ ξ z.1 h j k) =ᵐ[μ.prod μ]
      (μ.prod μ)[arrayCovarianceIntegrand ξ h j k | originalSigma] := by
  have heach (i : Fin n) := copyTruncatedCovariance_ae_eq_condExp μ (ξ i) (hξ i) hh j k
  have hall := ae_all_iff.mpr heach
  have hs := condExp_finset_sum (s := Finset.univ)
    (f := fun i => copyCovarianceIntegrand (ξ i) h j k)
    (fun i _ => integrable_copyCovarianceIntegrand μ (ξ i) (hξ i) hh j k)
    originalSigma
  have hfun : (∑ i, copyCovarianceIntegrand (ξ i) h j k) = arrayCovarianceIntegrand ξ h j k := by
    funext z
    simp only [Finset.sum_apply, arrayCovarianceIntegrand]
  rw [hfun] at hs
  have hsum : (fun z : Ω × Ω => ∑ i, copyTruncatedCovariance μ (ξ i) (ξ i z.1) h j k) =ᵐ[μ.prod μ]
      fun z => ∑ i, ((μ.prod μ)[copyCovarianceIntegrand (ξ i) h j k | originalSigma]) z := by
    filter_upwards [hall] with z hz
    exact Finset.sum_congr rfl (fun i _ => hz i)
  have hs' : (fun z : Ω × Ω => ∑ i,
      ((μ.prod μ)[copyCovarianceIntegrand (ξ i) h j k | originalSigma]) z) =ᵐ[μ.prod μ]
      (μ.prod μ)[arrayCovarianceIntegrand ξ h j k | originalSigma] := by
    filter_upwards [hs] with z hz
    simpa only [Finset.sum_apply] using hz.symm
  exact hsum.trans hs'

/-- An actual finite product array has each specified marginal law. The
laws indexed by the summands are arbitrary and need not coincide. -/
theorem probabilityPi_map_eval
    {ι E : Type*} [Fintype ι] [MeasurableSpace E]
    (ν : ι → Measure E) [∀ i, IsProbabilityMeasure (ν i)] (i : ι) :
    (Measure.pi ν).map (fun x => x i) = ν i := by
  classical
  ext s hs
  rw [Measure.map_apply (measurable_pi_apply i) hs,
    ← Set.univ_pi_update_univ, Measure.pi_pi]
  rw [Finset.prod_eq_single i]
  · simp
  · intro j _ hji
    simp [Function.update_of_ne hji]
  · simp

theorem integral_pi_eval_probability
    {ι E F : Type*} [Fintype ι] [MeasurableSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (ν : ι → Measure E) [∀ i, IsProbabilityMeasure (ν i)]
    (i : ι) (f : E → F) (hf : StronglyMeasurable f) :
    (∫ x, f (x i) ∂Measure.pi ν) = ∫ y, f y ∂ν i := by
  have hm := integral_map (μ := Measure.pi ν) (measurable_pi_apply i).aemeasurable
    hf.aestronglyMeasurable
  rw [probabilityPi_map_eval ν i] at hm
  exact hm.symm

private theorem measurable_truncated_at {p : ℕ} (x : Vector p) (h : ℝ) :
    Measurable (fun y : Vector p => pairedTruncatedIncrement x y h) := by
  unfold pairedTruncatedIncrement
  exact Measurable.ite
    (measurableSet_le (measurable_id.sub measurable_const).norm measurable_const)
    (measurable_id.sub measurable_const) measurable_const

theorem copyLargeIncrementMean_pi_eval {p n : ℕ}
    (ν : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (ν i)]
    (i : Fin n) (x : Vector p) (h : ℝ) :
    copyLargeIncrementMean (Measure.pi ν) (fun y => y i) x h =
      copyLargeIncrementMean (ν i) id x h := by
  exact integral_pi_eval_probability ν i
    (fun y => y - x - pairedTruncatedIncrement x y h)
    (((measurable_id.sub measurable_const).sub (measurable_truncated_at x h)).stronglyMeasurable)

theorem copyTruncatedCovariance_pi_eval {p n : ℕ}
    (ν : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (ν i)]
    (i : Fin n) (x : Vector p) (h : ℝ) (j k : Fin p) :
    copyTruncatedCovariance (Measure.pi ν) (fun y => y i) x h j k =
      copyTruncatedCovariance (ν i) id x h j k := by
  unfold copyTruncatedCovariance
  congr 1
  exact integral_pi_eval_probability ν i
    (fun y => pairedTruncatedIncrement x y h j * pairedTruncatedIncrement x y h k)
    ((((measurable_pi_apply j).comp (measurable_truncated_at x h)).mul
      ((measurable_pi_apply k).comp (measurable_truncated_at x h))).stronglyMeasurable)

theorem integrable_probabilityPi_coordinate {p n : ℕ}
    (ν : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (ν i)]
    (hi : ∀ i, Integrable id (ν i)) (i : Fin n) :
    Integrable (fun x => x i) (Measure.pi ν) := by
  have hmp : MeasurePreserving (fun x => x i) (Measure.pi ν) (ν i) :=
    ⟨measurable_pi_apply i, probabilityPi_map_eval ν i⟩
  exact (hmp.integrable_comp measurable_id.aestronglyMeasurable).mpr (hi i)

/-- The exact independent-copy product law for a possibly nonidentically
distributed finite array. Here the laws may be those of the normalized
observations, so the increments are already divided by `sqrt n`. -/
def productArrayCopyLaw {p n : ℕ} (ν : Fin n → Measure (Vector p)) :
    Measure ((Fin n → Vector p) × (Fin n → Vector p)) :=
  (Measure.pi ν).prod (Measure.pi ν)

/-- In the canonical array model this is precisely the sigma-field
generated by all original summands, not a sigma-field containing the copy. -/
theorem originalSigma_eq_original_coordinate_sigma {p n : ℕ} :
    originalSigma (α := Fin n → Vector p) (β := Fin n → Vector p) =
      ⨆ i : Fin n, (inferInstance : MeasurableSpace (Vector p)).comap
        (fun z : (Fin n → Vector p) × (Fin n → Vector p) => z.1 i) := by
  change ((⨆ i : Fin n, (inferInstance : MeasurableSpace (Vector p)).comap
    (fun x : Fin n → Vector p => x i)).comap Prod.fst) = _
  rw [MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp, Function.comp_def]

def productArrayLargeMean {p n : ℕ} (ν : Fin n → Measure (Vector p))
    (x : Fin n → Vector p) (h : ℝ) : Vector p :=
  ∑ i, copyLargeIncrementMean (ν i) id (x i) h

def productArrayTruncatedCovariance {p n : ℕ} (ν : Fin n → Measure (Vector p))
    (x : Fin n → Vector p) (h : ℝ) : Matrix (Fin p) (Fin p) ℝ :=
  fun j k => ∑ i, copyTruncatedCovariance (ν i) id (x i) h j k

/-- In the actual nonidentical product-array model, the explicit sum of
single-copy tail integrals is exactly the conditional coefficient `b_h`.
Only genuine first-moment integrability is needed for this identification. -/
theorem productArrayLargeMean_ae_eq_condExp {p n : ℕ}
    (ν : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (ν i)]
    (hi : ∀ i, Integrable id (ν i)) {h : ℝ} (hh : 0 ≤ h) :
    (fun z => productArrayLargeMean ν z.1 h) =ᵐ[productArrayCopyLaw ν]
      (productArrayCopyLaw ν)[arrayLargeIncrementIntegrand (fun i x => x i) h | originalSigma] := by
  have hg := copyArrayLargeMean_ae_eq_condExp (Measure.pi ν) (fun i x => x i)
    (fun i => measurable_pi_apply i) (integrable_probabilityPi_coordinate ν hi) hh
  filter_upwards [hg] with z hz
  change productArrayLargeMean ν z.1 h = _
  unfold productArrayCopyLaw
  rw [← hz]
  unfold productArrayLargeMean copyArrayLargeMean
  apply Finset.sum_congr rfl
  intro i _
  exact (copyLargeIncrementMean_pi_eval ν i (z.1 i) h).symm

/-- In the same product-array model, the explicit single-copy second
moments identify every entry of the actual conditional matrix `T_h`.
This identity does not require identical distribution or symmetry. -/
theorem productArrayTruncatedCovariance_ae_eq_condExp {p n : ℕ}
    (ν : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (ν i)]
    {h : ℝ} (hh : 0 ≤ h) (j k : Fin p) :
    (fun z => productArrayTruncatedCovariance ν z.1 h j k) =ᵐ[productArrayCopyLaw ν]
      (productArrayCopyLaw ν)[arrayCovarianceIntegrand (fun i x => x i) h j k | originalSigma] := by
  have hg := copyArrayTruncatedCovariance_ae_eq_condExp (Measure.pi ν) (fun i x => x i)
    (fun i => measurable_pi_apply i) hh j k
  filter_upwards [hg] with z hz
  change productArrayTruncatedCovariance ν z.1 h j k = _
  unfold productArrayCopyLaw
  rw [← hz]
  unfold productArrayTruncatedCovariance copyArrayTruncatedCovariance
  apply Finset.sum_congr rfl
  intro i _
  exact (copyTruncatedCovariance_pi_eval ν i (z.1 i) h j k).symm

end

