import RectangleCLTCompanion.SplitV4.OrliczFaceTransfer
import RectangleCLT.BoundedIndependentScaling
import RectangleCLT.TruncationCovarianceIdentity
import Mathlib.Probability.ConditionalProbability

/-!
# Actual conditional laws for Appendix E truncation

The good and bad laws are normalized restrictions of the original vector
law. A zero-mass event uses a Dirac fallback and has zero mixture weight.
The fixed-mask good-product construction below is a genuine probability
model, with independence and a bounded centered good component proved.
Identification with the full sigma-field generated by masks and exceptional
values is a further disintegration obligation, not asserted here.
-/

open MeasureTheory ProbabilityTheory
open scoped BigOperators

namespace RectangleCLT.Companion.SplitV4

noncomputable section

set_option autoImplicit false

def conditionalVectorLaw {p : ℕ} (μ : Measure (Vector p)) (S : Set (Vector p)) :
    Measure (Vector p) :=
  if μ S = 0 then Measure.dirac 0 else ProbabilityTheory.cond μ S

instance conditionalVectorLaw_isProbability {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] (S : Set (Vector p)) :
    IsProbabilityMeasure (conditionalVectorLaw μ S) := by
  unfold conditionalVectorLaw
  split_ifs with h
  · infer_instance
  · exact ProbabilityTheory.cond_isProbabilityMeasure h

theorem conditionalVectorLaw_eq_cond {p : ℕ}
    (μ : Measure (Vector p)) (S : Set (Vector p)) (hS : μ S ≠ 0) :
    conditionalVectorLaw μ S = ProbabilityTheory.cond μ S := by
  simp only [conditionalVectorLaw, if_neg hS]

theorem mass_smul_conditionalVectorLaw {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] (S : Set (Vector p)) :
    μ S • conditionalVectorLaw μ S = μ.restrict S := by
  by_cases hS : μ S = 0
  · simp only [conditionalVectorLaw, if_pos hS, hS, zero_smul]
    exact (Measure.restrict_eq_zero.mpr hS).symm
  · rw [conditionalVectorLaw_eq_cond μ S hS, ProbabilityTheory.cond,
      smul_smul, ENNReal.mul_inv_cancel hS (measure_ne_top μ S), one_smul]

/-- The actual good/bad conditional laws reconstruct the original law,
including when the bad event has probability zero. -/
theorem conditional_good_bad_mixture {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ]
    (S : Set (Vector p)) (hS : MeasurableSet S) :
    μ S • conditionalVectorLaw μ S + μ Sᶜ • conditionalVectorLaw μ Sᶜ = μ := by
  rw [mass_smul_conditionalVectorLaw, mass_smul_conditionalVectorLaw,
    Measure.restrict_add_restrict_compl hS]

def goodTruncationSet {p : ℕ} (T : ℝ) : Set (Vector p) := {x | ‖x‖ ≤ T}

theorem measurableSet_goodTruncationSet {p : ℕ} (T : ℝ) :
    MeasurableSet (goodTruncationSet (p := p) T) :=
  measurableSet_le measurable_norm measurable_const

def goodConditionalLaw {p : ℕ} (μ : Measure (Vector p)) (T : ℝ) :
    Measure (Vector p) := conditionalVectorLaw μ (goodTruncationSet T)

instance goodConditionalLaw_isProbability {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] (T : ℝ) :
    IsProbabilityMeasure (goodConditionalLaw μ T) := inferInstanceAs
      (IsProbabilityMeasure (conditionalVectorLaw μ (goodTruncationSet T)))

def conditionalGoodMean {p : ℕ} (μ : Measure (Vector p)) (T : ℝ) : Vector p :=
  fun j => ∫ x, x j ∂goodConditionalLaw μ T

theorem goodConditionalLaw_ae_norm_le {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) :
    ∀ᵐ x ∂goodConditionalLaw μ T, ‖x‖ ≤ T := by
  by_cases hS : μ (goodTruncationSet T) = 0
  · simp only [goodConditionalLaw, conditionalVectorLaw, if_pos hS, ae_dirac_eq]
    simpa only [Filter.eventually_pure, norm_zero] using hT
  · rw [goodConditionalLaw, conditionalVectorLaw_eq_cond μ _ hS]
    exact ProbabilityTheory.ae_cond_mem (measurableSet_goodTruncationSet T)

theorem integrable_goodConditional_coordinate {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) (j : Fin p) :
    Integrable (fun x => x j) (goodConditionalLaw μ T) := by
  apply (integrable_const T).mono' (measurable_pi_apply j).aestronglyMeasurable
  filter_upwards [goodConditionalLaw_ae_norm_le μ hT] with x hx
  exact (norm_le_pi_norm x j).trans hx

theorem integrable_goodConditional_coordinate_pair {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) (j k : Fin p) :
    Integrable (fun x => x j * x k) (goodConditionalLaw μ T) := by
  apply (integrable_const (T ^ 2)).mono'
    ((measurable_pi_apply j).mul (measurable_pi_apply k)).aestronglyMeasurable
  filter_upwards [goodConditionalLaw_ae_norm_le μ hT] with x hx
  simpa only [norm_mul, pow_two] using
    mul_le_mul ((norm_le_pi_norm x j).trans hx) ((norm_le_pi_norm x k).trans hx)
      (norm_nonneg _) hT

theorem norm_conditionalGoodMean_le {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) :
    ‖conditionalGoodMean μ T‖ ≤ T := by
  apply (pi_norm_le_iff_of_nonneg hT).mpr
  intro j
  have hb : ∀ᵐ x ∂goodConditionalLaw μ T, ‖x j‖ ≤ T := by
    filter_upwards [goodConditionalLaw_ae_norm_le μ hT] with x hx
    exact (norm_le_pi_norm x j).trans hx
  simpa only [conditionalGoodMean, measureReal_univ_eq_one, mul_one] using
    norm_integral_le_of_norm_le_const hb

theorem conditionalGood_centered {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) (j : Fin p) :
    (∫ x, (x - conditionalGoodMean μ T) j ∂goodConditionalLaw μ T) = 0 := by
  change (∫ x, x j - conditionalGoodMean μ T j ∂goodConditionalLaw μ T) = 0
  rw [integral_sub (integrable_goodConditional_coordinate μ hT j) (integrable_const _)]
  simp only [integral_const, measureReal_univ_eq_one, one_smul, conditionalGoodMean, sub_self]

theorem conditionalGood_ae_centered_norm_le {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) :
    ∀ᵐ x ∂goodConditionalLaw μ T, ‖x - conditionalGoodMean μ T‖ ≤ 2 * T := by
  filter_upwards [goodConditionalLaw_ae_norm_le μ hT] with x hx
  exact (norm_sub_le x _).trans ((add_le_add hx (norm_conditionalGoodMean_le μ hT)).trans_eq (by ring))

/-- The actual normalized restriction has precisely its conditional second
moment minus the conditional-mean outer product as covariance. -/
theorem goodConditional_covariance_restrict {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] (T : ℝ)
    (hS : μ (goodTruncationSet T) ≠ 0) (j k : Fin p) :
    covariance (goodConditionalLaw μ T) id j k =
      (μ.real (goodTruncationSet T))⁻¹ *
        (∫ x in goodTruncationSet T, x j * x k ∂μ) -
      conditionalGoodMean μ T j * conditionalGoodMean μ T k := by
  change (∫ x, x j * x k ∂goodConditionalLaw μ T) -
    conditionalGoodMean μ T j * conditionalGoodMean μ T k = _
  rw [goodConditionalLaw, conditionalVectorLaw_eq_cond μ _ hS, ProbabilityTheory.cond,
    integral_smul_measure]
  simp only [ENNReal.toReal_inv, smul_eq_mul, Measure.real]

theorem goodConditional_covariance_tail {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] (T : ℝ)
    (hS : μ (goodTruncationSet T) ≠ 0) (j k : Fin p)
    (hint : Integrable (fun x : Vector p => x j * x k) μ) :
    covariance (goodConditionalLaw μ T) id j k =
      (μ.real (goodTruncationSet T))⁻¹ *
        ((∫ x, x j * x k ∂μ) - ∫ x in (goodTruncationSet T)ᶜ, x j * x k ∂μ) -
      conditionalGoodMean μ T j * conditionalGoodMean μ T k := by
  rw [goodConditional_covariance_restrict μ T hS]
  congr 2
  have hh := integral_add_compl (measurableSet_goodTruncationSet T) hint
  linarith

/-- Markov's inequality for the actual exceptional-vector event. -/
theorem exceptional_probability_le_rpow {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] (B T q : ℝ)
    (hB : 0 ≤ B) (hT : 0 < T) (hq : 0 < q)
    (hint : Integrable (fun x : Vector p => ‖x‖ ^ q) μ)
    (hmoment : (∫ x : Vector p, ‖x‖ ^ q ∂μ) ≤ B ^ q) :
    μ.real (goodTruncationSet T)ᶜ ≤ (B / T) ^ q := by
  have hpow : 0 < T ^ q := Real.rpow_pos_of_pos hT q
  have hsub : (goodTruncationSet (p := p) T)ᶜ ⊆ {x | T ^ q ≤ ‖x‖ ^ q} := by
    intro x hx
    change ¬ ‖x‖ ≤ T at hx
    have hTx : T ≤ ‖x‖ := (lt_of_not_ge hx).le
    exact Real.rpow_le_rpow hT.le hTx hq.le
  have hm := mul_meas_ge_le_integral_of_nonneg
    (ae_of_all μ (fun x : Vector p => Real.rpow_nonneg (norm_nonneg x) q)) hint (T ^ q)
  have ht := (mul_le_mul_of_nonneg_left (measureReal_mono hsub) hpow.le).trans
    (hm.trans hmoment)
  rw [Real.div_rpow hB hT.le]
  exact (le_div_iff₀ hpow).mpr (by simpa only [mul_comm] using ht)

theorem exceptional_probability_lt_quarter {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] (B T q : ℝ)
    (hB : 0 < B) (hT : 2 * B ≤ T) (hq : 2 < q)
    (hint : Integrable (fun x : Vector p => ‖x‖ ^ q) μ)
    (hmoment : (∫ x : Vector p, ‖x‖ ^ q ∂μ) ≤ B ^ q) :
    μ.real (goodTruncationSet T)ᶜ < 1 / 4 := by
  have hTp : 0 < T := lt_of_lt_of_le (by positivity : 0 < 2 * B) hT
  have hratio : B / T ≤ (1 / 2 : ℝ) := (div_le_iff₀ hTp).mpr (by linarith)
  have hpow := Real.rpow_le_rpow (div_nonneg hB.le hTp.le) hratio (by linarith : 0 ≤ q)
  have hstrict := Real.rpow_lt_rpow_of_exponent_gt
    (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1) hq
  have htwo : (1 / 2 : ℝ) ^ (2 : ℝ) = 1 / 4 := by norm_num [Real.rpow_two]
  rw [htwo] at hstrict
  exact (exceptional_probability_le_rpow μ B T q hB.le hTp (by linarith) hint hmoment).trans_lt
    (hpow.trans_lt hstrict)

theorem goodTruncation_mass_ne_zero_of_bad_probability_lt_one {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] (T : ℝ)
    (hbad : μ.real (goodTruncationSet T)ᶜ < 1) :
    μ (goodTruncationSet T) ≠ 0 := by
  have hh := measureReal_add_measureReal_compl (μ := μ) (measurableSet_goodTruncationSet T)
  rw [measureReal_univ_eq_one] at hh
  intro hzero
  have hz : μ.real (goodTruncationSet T) = 0 := by simp only [Measure.real, hzero, ENNReal.toReal_zero]
  linarith

def conditionalGoodProductLaw {p n : ℕ} (μ : Fin n → Measure (Vector p)) (T : ℝ) :
    Measure (Fin n → Vector p) := Measure.pi (fun i => goodConditionalLaw (μ i) T)

instance conditionalGoodProductLaw_isProbability {p n : ℕ}
    (μ : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (μ i)] (T : ℝ) :
    IsProbabilityMeasure (conditionalGoodProductLaw μ T) := by
  unfold conditionalGoodProductLaw
  infer_instance

theorem conditionalGoodProductLaw_map_eval {p n : ℕ}
    (μ : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (μ i)]
    (T : ℝ) (i : Fin n) :
    (conditionalGoodProductLaw μ T).map (fun x => x i) = goodConditionalLaw (μ i) T := by
  classical
  ext S hS
  rw [Measure.map_apply (measurable_pi_apply i) hS]
  have he : (fun x : Fin n → Vector p => x i) ⁻¹' S =
      Set.pi Set.univ (fun k => if k = i then S else Set.univ) := by
    ext x
    simp only [Set.mem_preimage, Set.mem_pi, Set.mem_univ, true_implies]
    constructor
    · intro hx k
      by_cases hk : k = i
      · subst k; simpa using hx
      · simp [hk]
    · intro hx
      simpa using hx i
  rw [he]
  unfold conditionalGoodProductLaw
  rw [Measure.pi_pi]
  simp [apply_ite, measure_univ]

theorem conditionalGoodProductLaw_independent {p n : ℕ}
    (μ : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (μ i)] (T : ℝ) :
    iIndepFun (fun i (x : Fin n → Vector p) => x i) (conditionalGoodProductLaw μ T) := by
  apply (iIndepFun_iff_map_fun_eq_pi_map
    (fun i => (measurable_pi_apply i).aemeasurable)).mpr
  change (conditionalGoodProductLaw μ T).map id = _
  rw [Measure.map_id]
  simp only [conditionalGoodProductLaw_map_eval]
  rfl

def conditionalRetainedSummand {p n : ℕ}
    (μ : Fin n → Measure (Vector p)) (T : ℝ) (mask : Fin n → Bool)
    (i : Fin n) (x : Fin n → Vector p) : Vector p :=
  if mask i then 0 else x i - conditionalGoodMean (μ i) T

/-- For each fixed exceptional mask the actual good conditional laws form
an independent centered bounded array, with no identical-law assumption. -/
theorem conditionalRetained_boundedIndependent {p n : ℕ}
    (μ : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (μ i)]
    {T : ℝ} (hT : 0 ≤ T) (mask : Fin n → Bool) :
    BoundedIndependentHypotheses (conditionalGoodProductLaw μ T)
      (conditionalRetainedSummand μ T mask) (2 * T) := by
  have hm (i : Fin n) : Measurable (conditionalRetainedSummand μ T mask i) := by
    unfold conditionalRetainedSummand
    split_ifs
    · exact measurable_const
    · exact (measurable_pi_apply i).sub measurable_const
  refine ⟨hm, ?_, ?_, ?_, by positivity⟩
  · exact (conditionalGoodProductLaw_independent μ T).comp
      (fun i (x : Vector p) => if mask i then 0 else x - conditionalGoodMean (μ i) T)
      (fun i => by dsimp only; split_ifs <;> fun_prop)
  · intro i j
    by_cases hi : mask i = true
    · simp only [conditionalRetainedSummand, hi, if_true, Pi.zero_apply, integral_zero]
    · have hmap := integral_map (μ := conditionalGoodProductLaw μ T)
        (f := fun x : Vector p => (x - conditionalGoodMean (μ i) T) j)
        (measurable_pi_apply i).aemeasurable
        (((measurable_pi_apply j).sub measurable_const).aestronglyMeasurable)
      rw [conditionalGoodProductLaw_map_eval] at hmap
      simpa only [conditionalRetainedSummand, hi, Bool.false_eq_true, if_false] using
        hmap.symm.trans (conditionalGood_centered (μ i) hT j)
  · intro i
    by_cases hi : mask i = true
    · exact ae_of_all _ fun _ => by simp [conditionalRetainedSummand, hi, hT]
    · have ha : ∀ᵐ x ∂(conditionalGoodProductLaw μ T).map (fun x => x i),
          ‖x - conditionalGoodMean (μ i) T‖ ≤ 2 * T := by
        rw [conditionalGoodProductLaw_map_eval]
        exact conditionalGood_ae_centered_norm_le (μ i) hT
      simpa only [conditionalRetainedSummand, hi, Bool.false_eq_true, if_false] using
        ae_of_ae_map (measurable_pi_apply i).aemeasurable ha

theorem integral_conditionalGood_centered_pair {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) (j k : Fin p) :
    (∫ x, (x - conditionalGoodMean μ T) j * (x - conditionalGoodMean μ T) k
      ∂goodConditionalLaw μ T) = covariance (goodConditionalLaw μ T) id j k := by
  have hc := covariance_sub_const
    (μ := goodConditionalLaw μ T) (Y := id)
    (integrable_goodConditional_coordinate μ hT)
    (integrable_goodConditional_coordinate_pair μ hT) (conditionalGoodMean μ T)
  have he := congrFun (congrFun hc j) k
  simpa only [covariance, id_eq, conditionalGood_centered μ hT, mul_zero, sub_zero] using he

theorem integral_conditionalRetained_pair {p n : ℕ}
    (μ : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (μ i)]
    {T : ℝ} (hT : 0 ≤ T) (mask : Fin n → Bool) (i : Fin n) (j k : Fin p) :
    (∫ x, conditionalRetainedSummand μ T mask i x j * conditionalRetainedSummand μ T mask i x k
      ∂conditionalGoodProductLaw μ T) =
        if mask i then 0 else covariance (goodConditionalLaw (μ i) T) id j k := by
  by_cases hi : mask i = true
  · simp only [conditionalRetainedSummand, hi, if_true, Pi.zero_apply, zero_mul, integral_zero]
  · have hm : Measurable (fun x : Vector p =>
        (x - conditionalGoodMean (μ i) T) j * (x - conditionalGoodMean (μ i) T) k) :=
      ((measurable_pi_apply j).sub measurable_const).mul
        ((measurable_pi_apply k).sub measurable_const)
    have hmap := integral_map (μ := conditionalGoodProductLaw μ T)
      (f := fun x : Vector p =>
        (x - conditionalGoodMean (μ i) T) j * (x - conditionalGoodMean (μ i) T) k)
      (measurable_pi_apply i).aemeasurable hm.aestronglyMeasurable
    rw [conditionalGoodProductLaw_map_eval] at hmap
    simpa only [conditionalRetainedSummand, hi, Bool.false_eq_true, if_false] using
      hmap.symm.trans (integral_conditionalGood_centered_pair (μ i) hT j k)

/-- Exact covariance of the bounded component for a fixed exceptional mask.
The conditional covariance is computed from the actual good laws. -/
theorem conditionalRetained_covariance_sum {p n : ℕ}
    (μ : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (μ i)]
    {T : ℝ} (hT : 0 ≤ T) (mask : Fin n → Bool) (j k : Fin p) :
    covariance (conditionalGoodProductLaw μ T)
      (sumVector (conditionalRetainedSummand μ T mask)) j k =
      ∑ i, if mask i then 0 else covariance (goodConditionalLaw (μ i) T) id j k := by
  rw [(conditionalRetained_boundedIndependent μ hT mask).covariance_sum]
  apply Finset.sum_congr rfl
  intro i _
  exact integral_conditionalRetained_pair μ hT mask i j k

/-- The manuscript's fixed-mask matrix `Q=(1/n)∑(1-I_i)C_i^0` is the actual
covariance of the constructed normalized conditional array. -/
theorem conditionalRetained_normalized_covariance {p n : ℕ}
    (μ : Fin n → Measure (Vector p)) [∀ i, IsProbabilityMeasure (μ i)]
    {T : ℝ} (hT : 0 ≤ T) (mask : Fin n → Bool) (j k : Fin p) :
    covariance (conditionalGoodProductLaw μ T)
      (normalizedObservationSum (conditionalRetainedSummand μ T mask)) j k =
      (1 / (n : ℝ)) * ∑ i, if mask i then 0 else covariance (goodConditionalLaw (μ i) T) id j k := by
  have hc := (conditionalRetained_boundedIndependent μ hT mask).covariance_sum_smul
    ((Real.sqrt (n : ℝ))⁻¹)
  have hsum : sumVector (fun i x => (Real.sqrt (n : ℝ))⁻¹ • conditionalRetainedSummand μ T mask i x) =
      normalizedObservationSum (conditionalRetainedSummand μ T mask) := by
    funext x
    exact sumVector_smul _ _ x
  rw [hsum] at hc
  rw [hc]
  simp only [Matrix.smul_apply, smul_eq_mul, inv_pow, Real.sq_sqrt (Nat.cast_nonneg n), one_div]
  rw [conditionalRetained_covariance_sum μ hT mask]

def conditionalGoodPart {p : ℕ} (μ : Measure (Vector p)) (T : ℝ) (x : Vector p) : Vector p :=
  if ‖x‖ ≤ T then x - conditionalGoodMean μ T else 0

def conditionalExceptionalPart {p : ℕ} (μ : Measure (Vector p)) (T : ℝ) (x : Vector p) : Vector p :=
  if ‖x‖ ≤ T then conditionalGoodMean μ T else x

theorem conditional_decomposition {p : ℕ}
    (μ : Measure (Vector p)) (T : ℝ) (x : Vector p) :
    conditionalGoodPart μ T x + conditionalExceptionalPart μ T x = x := by
  unfold conditionalGoodPart conditionalExceptionalPart
  split_ifs <;> simp

theorem measurable_conditionalGoodPart {p : ℕ} (μ : Measure (Vector p)) (T : ℝ) :
    Measurable (conditionalGoodPart μ T) :=
  Measurable.ite (measurableSet_goodTruncationSet T)
    (measurable_id.sub measurable_const) measurable_const

theorem measurable_conditionalExceptionalPart {p : ℕ} (μ : Measure (Vector p)) (T : ℝ) :
    Measurable (conditionalExceptionalPart μ T) :=
  Measurable.ite (measurableSet_goodTruncationSet T) measurable_const measurable_id

theorem norm_conditionalGoodPart_le {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) (x : Vector p) :
    ‖conditionalGoodPart μ T x‖ ≤ 2 * T := by
  by_cases hx : ‖x‖ ≤ T
  · rw [conditionalGoodPart, if_pos hx]
    exact (norm_sub_le x _).trans
      ((add_le_add hx (norm_conditionalGoodMean_le μ hT)).trans_eq (by ring))
  · simp only [conditionalGoodPart, if_neg hx, norm_zero]
    positivity

/-- The good component is centered also on the original law, rather than
only on the normalized restricted law. -/
theorem conditionalGoodPart_centered {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) (j : Fin p) :
    (∫ x, conditionalGoodPart μ T x j ∂μ) = 0 := by
  have he : (fun x => conditionalGoodPart μ T x j) =
      (goodTruncationSet T).indicator (fun x : Vector p => (x - conditionalGoodMean μ T) j) := by
    funext x
    by_cases hx : ‖x‖ ≤ T <;> simp [conditionalGoodPart, goodTruncationSet, hx]
  rw [he, integral_indicator (measurableSet_goodTruncationSet T),
    ← mass_smul_conditionalVectorLaw μ (goodTruncationSet T), integral_smul_measure]
  change (μ (goodTruncationSet T)).toReal *
    (∫ x, (x - conditionalGoodMean μ T) j ∂goodConditionalLaw μ T) = 0
  rw [conditionalGood_centered μ hT j, mul_zero]

theorem conditionalExceptionalPart_centered {p : ℕ}
    (μ : Measure (Vector p)) [IsProbabilityMeasure μ] {T : ℝ} (hT : 0 ≤ T) (j : Fin p)
    (hint : Integrable (fun x : Vector p => x j) μ) (hc : (∫ x : Vector p, x j ∂μ) = 0) :
    (∫ x, conditionalExceptionalPart μ T x j ∂μ) = 0 := by
  have hgood : Integrable (fun x => conditionalGoodPart μ T x j) μ := by
    apply (integrable_const (2 * T)).mono'
      ((measurable_pi_apply j).comp (measurable_conditionalGoodPart μ T)).aestronglyMeasurable
    exact ae_of_all μ fun x => (norm_le_pi_norm _ j).trans (norm_conditionalGoodPart_le μ hT x)
  have he (x : Vector p) : conditionalExceptionalPart μ T x j = x j - conditionalGoodPart μ T x j := by
    have hh := congrFun (conditional_decomposition μ T x) j
    simp only [Pi.add_apply] at hh
    linarith
  simp_rw [he]
  rw [integral_sub hint hgood, hc, conditionalGoodPart_centered μ hT j, sub_self]

theorem conditionalExceptionalPart_independent
    {Ω : Type*} [MeasurableSpace Ω] {p n : ℕ} {μ : Measure Ω}
    (X : Fin n → Ω → Vector p) (hind : iIndepFun X μ)
    (laws : Fin n → Measure (Vector p)) (T : ℝ) :
    iIndepFun (fun i ω => conditionalExceptionalPart (laws i) T (X i ω)) μ :=
  hind.comp (fun i => conditionalExceptionalPart (laws i) T)
    (fun i => measurable_conditionalExceptionalPart (laws i) T)

/-- The actual good component on the original observation space is also
centered and bounded. Its means are computed under the actual marginal laws. -/
theorem originalGoodPart_boundedIndependent
    {Ω : Type*} [MeasurableSpace Ω] {p n : ℕ}
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : Fin n → Ω → Vector p)
    (hX : ∀ i, Measurable (X i)) (hind : iIndepFun X μ) {T : ℝ} (hT : 0 ≤ T) :
    BoundedIndependentHypotheses μ
      (fun i ω => conditionalGoodPart (μ.map (X i)) T (X i ω)) (2 * T) := by
  haveI : ∀ i, IsProbabilityMeasure (μ.map (X i)) :=
    fun i => isProbabilityMeasure_map (hX i).aemeasurable
  refine ⟨fun i => (measurable_conditionalGoodPart (μ.map (X i)) T).comp (hX i),
    hind.comp (fun i => conditionalGoodPart (μ.map (X i)) T)
      (fun i => measurable_conditionalGoodPart (μ.map (X i)) T), ?_, ?_, by positivity⟩
  · intro i j
    have hmap := integral_map (μ := μ) (hX i).aemeasurable
      (f := fun x : Vector p => conditionalGoodPart (μ.map (X i)) T x j)
      (((measurable_pi_apply j).comp (measurable_conditionalGoodPart (μ.map (X i)) T)).aestronglyMeasurable)
    exact hmap.symm.trans (conditionalGoodPart_centered (μ.map (X i)) hT j)
  · intro i
    exact ae_of_all μ fun ω => norm_conditionalGoodPart_le (μ.map (X i)) hT (X i ω)

def truncationMaskSet {p : ℕ} (T : ℝ) (bad : Bool) : Set (Vector p) :=
  if bad then (goodTruncationSet T)ᶜ else goodTruncationSet T

theorem measurableSet_truncationMaskSet {p : ℕ} (T : ℝ) (bad : Bool) :
    MeasurableSet (truncationMaskSet (p := p) T bad) := by
  unfold truncationMaskSet
  split_ifs
  · exact (measurableSet_goodTruncationSet T).compl
  · exact measurableSet_goodTruncationSet T

def truncationMaskEvent {Ω : Type*} {p n : ℕ}
    (X : Fin n → Ω → Vector p) (T : ℝ) (mask : Fin n → Bool) : Set Ω :=
  ⋂ i, X i ⁻¹' truncationMaskSet T (mask i)

/-- Actual independence on the original observation space after conditioning
on any non-null finite good/bad mask. Conditioning also on the exceptional
values requires the further disintegration stated in the module header. -/
theorem originalArray_independent_given_mask
    {Ω : Type*} [MeasurableSpace Ω] {p n : ℕ} {μ : Measure Ω}
    (X : Fin n → Ω → Vector p) (hX : ∀ i, Measurable (X i))
    (hind : iIndepFun X μ) (T : ℝ) (mask : Fin n → Bool)
    (hpos : ∀ i, μ (X i ⁻¹' truncationMaskSet T (mask i)) ≠ 0) :
    iIndepFun X (ProbabilityTheory.cond μ (truncationMaskEvent X T mask)) := by
  have hpair : iIndepFun (fun i ω => (X i ω, X i ω)) μ :=
    hind.comp (fun _ (x : Vector p) => (x, x))
      (fun _ => measurable_id.prodMk measurable_id)
  exact ProbabilityTheory.iIndepFun.cond hX hpair hpos
    (fun i => measurableSet_truncationMaskSet T (mask i))

end

