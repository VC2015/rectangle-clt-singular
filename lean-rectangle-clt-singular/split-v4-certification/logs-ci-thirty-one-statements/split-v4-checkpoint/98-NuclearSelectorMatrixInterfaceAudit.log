def RectangleCLT.Companion.SplitV4.RectangleBaseConcentration : {p : ℕ} →
  MeasureTheory.Measure (RectangleCLT.Vector p) → ℝ → ℝ → ℝ → Prop :=
fun {p} μ C δ L =>
  ∀ (t : RectangleCLT.FaceSmoother p) (z : RectangleCLT.Vector p) (s : ℝ),
    0 < s → μ.real {x | x + z ∈ t.boundaryLayer s} ≤ C * (s + δ) * √L
