def RectangleCLT.Companion.SplitV4.moderateScalarTilt.{u_1} : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → MeasureTheory.Measure Ω :=
fun {Ω} [MeasurableSpace Ω] μ X t => μ.tilted fun ω => t * X ω
def RectangleCLT.Companion.SplitV4.moderateTiltMoment.{u_1} : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℕ → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ X k t => (∫ (ω : Ω), X ω ^ k * Real.exp (t * X ω) ∂μ) / ProbabilityTheory.mgf X μ t
def RectangleCLT.Companion.SplitV4.moderateTiltFourthCumulant.{u_1} : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ X t =>
  RectangleCLT.Companion.SplitV4.moderateTiltMoment μ X 4 t -
          4 * RectangleCLT.Companion.SplitV4.moderateTiltMoment μ X 3 t *
            RectangleCLT.Companion.SplitV4.moderateTiltMean μ X t -
        3 * RectangleCLT.Companion.SplitV4.moderateTiltMoment μ X 2 t ^ 2 +
      12 * RectangleCLT.Companion.SplitV4.moderateTiltMoment μ X 2 t *
        RectangleCLT.Companion.SplitV4.moderateTiltMean μ X t ^ 2 -
    6 * RectangleCLT.Companion.SplitV4.moderateTiltMean μ X t ^ 4
def RectangleCLT.Companion.SplitV4.moderateArrayCGF.{u_1} : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → {n : ℕ} → MeasureTheory.Measure Ω → (Fin n → Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] {n} μ η t => ∑ i, ProbabilityTheory.cgf (η i) μ t
def RectangleCLT.Companion.SplitV4.moderateArrayGamma.{u_1} : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → {n : ℕ} → MeasureTheory.Measure Ω → (Fin n → Ω → ℝ) → ℝ :=
fun {Ω} [MeasurableSpace Ω] {n} μ η => ∑ i, ∫ (ω : Ω), η i ω ^ 3 ∂μ
def RectangleCLT.Companion.SplitV4.moderateScalarSum.{u_1} : {Ω : Type u_1} → {n : ℕ} → (Fin n → Ω → ℝ) → Ω → ℝ :=
fun {Ω} {n} η ω => ∑ i, η i ω
def RectangleCLT.Companion.SplitV4.moderateProductWeightedTail : {n : ℕ} → (Fin n → MeasureTheory.Measure ℝ) → ℝ → ℝ :=
fun {n} ν t =>
  ∫ (z : Fin n → ℝ),
    RectangleCLT.Companion.lowerStrictTailWeight (RectangleCLT.Companion.SplitV4.moderateProductTailScale ν t)
      (RectangleCLT.Companion.SplitV4.genericTiltedStandardizedSum ν t
        z) ∂RectangleCLT.Companion.SplitV4.genericTiltedProduct ν t
def RectangleCLT.Companion.SplitV4.moderateTaylorConstant : ℝ :=
7 * Real.exp 4
def RectangleCLT.Companion.SplitV4.moderateTailSmallConstant : ℝ :=
100 * RectangleCLT.Companion.SplitV4.moderateTaylorConstant +
      6 * RectangleCLT.Companion.SplitV4.moderateWeightedConstant +
    2 * RectangleCLT.scalarBerryEsseenConstant / RectangleCLT.Companion.standardNormalUpperTail 2 +
  1
def RectangleCLT.Companion.SplitV4.moderateTailRemainderConstant : ℝ :=
RectangleCLT.Companion.SplitV4.moderateSmallTailConstant + 6 * RectangleCLT.Companion.SplitV4.moderateWeightedConstant +
      2 *
        RectangleCLT.Companion.SplitV4.moderateCancellationConstant
          RectangleCLT.Companion.SplitV4.moderateTaylorConstant +
    RectangleCLT.Companion.SplitV4.moderateLegendreConstant RectangleCLT.Companion.SplitV4.moderateTaylorConstant +
  1
