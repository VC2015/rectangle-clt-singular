def RectangleCLT.Companion.SplitV4.intrinsicCubeMean : {m n : ℕ} → (Fin m → Fin n → ℝ) → ℝ :=
fun {m n} b => Kane.avg (RectangleCLT.Companion.SplitV4.positiveLinearMaximum b)
