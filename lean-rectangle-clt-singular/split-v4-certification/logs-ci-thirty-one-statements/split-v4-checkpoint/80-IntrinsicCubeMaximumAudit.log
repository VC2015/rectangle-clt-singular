def RectangleCLT.Companion.SplitV4.cubeLinear : {n : ℕ} → (Fin n → ℝ) → Kane.Cube n → ℝ :=
fun {n} b x => ∑ i, b i * RectangleCLT.Companion.SplitV4.cubeSign x i
def RectangleCLT.Companion.SplitV4.positiveLinearMaximum : {m n : ℕ} → (Fin m → Fin n → ℝ) → Kane.Cube n → ℝ :=
