def RectangleCLT.Companion.SplitV4.gaussianPairConditionalDirection : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → Fin m → Fin m → RectangleCLT.Vector r :=
fun {m r} u j l =>
  (RectangleCLT.Companion.SplitV4.gaussianThresholdResidualScale u j l)⁻¹ •
    RectangleCLT.Companion.SplitV4.gaussianNormalProjection (u j) (u l)
def RectangleCLT.Companion.SplitV4.gaussianPairConditionalLevel : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → Fin m → Fin m → ℝ :=
fun {m r} u b j l =>
  (b l - b j * RectangleCLT.faceDot (u l) (u j)) / RectangleCLT.Companion.SplitV4.gaussianThresholdResidualScale u j l
