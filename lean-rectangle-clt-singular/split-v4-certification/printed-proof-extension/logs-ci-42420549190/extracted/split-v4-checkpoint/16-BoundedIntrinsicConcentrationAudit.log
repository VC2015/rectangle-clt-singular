def RectangleCLT.Companion.SplitV4.projectedFacePolyhedron : {p : ℕ} →
  RectangleCLT.Vector p → ℝ → Set (RectangleCLT.Vector p) :=
fun {p} a s => {y | ∀ (j : Fin p), y j ≤ a j + s}
def RectangleCLT.Companion.SplitV4.projectedFaceLayer : {p : ℕ} →
