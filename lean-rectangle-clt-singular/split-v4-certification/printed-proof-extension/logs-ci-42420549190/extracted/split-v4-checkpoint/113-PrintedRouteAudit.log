def RectangleCLT.Companion.SplitV4.Printed.CubeUniqueMax : {m n : ℕ} → (Fin m → Fin n → ℝ) → (Fin m → ℝ) → Prop :=
fun {m n} B a =>
  ∀ (x : Kane.Cube n),
    ∃ α,
      ∀ (β : Fin m),
        β ≠ α →
          RectangleCLT.Companion.SplitV4.cubeLinear (B β) x - a β <
            RectangleCLT.Companion.SplitV4.cubeLinear (B α) x - a α
