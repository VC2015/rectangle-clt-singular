def RectangleCLT.Companion.SubexponentialCLT.{u} : ℝ → Prop :=
fun C =>
  ∀ {Ω : Type u} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [inst_1 : MeasureTheory.IsProbabilityMeasure μ] (p n : ℕ),
    1 ≤ p →
      1 ≤ n →
        ∀ (X : Fin n → Ω → RectangleCLT.Vector p) (K : ℝ) (A : Matrix (Fin p) (Fin p) ℝ),
          RectangleCLT.Companion.SubexponentialIndependentHypotheses μ X K →
            (∀ (j : Fin p), RectangleCLT.covariance μ (RectangleCLT.Companion.normalizedObservationSum X) j j = 1) →
              A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.Companion.normalizedObservationSum X) →
                ∀ (R : RectangleCLT.Rect p),
                  RectangleCLT.rectangleError μ (RectangleCLT.Companion.normalizedObservationSum X) A R ≤
                    C *
                      min 1
                        (RectangleCLT.Companion.unrestrictedRate (RectangleCLT.Companion.subexponentialScale n K)
                          (RectangleCLT.dimensionLog p))
def RectangleCLT.Companion.FixedGapSubexponentialCLT.{u} : ℝ → ℝ → Prop :=
fun c₀ C =>
  ∀ {Ω : Type u} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [inst_1 : MeasureTheory.IsProbabilityMeasure μ] (p n : ℕ),
    1 ≤ p →
      1 ≤ n →
        ∀ (X : Fin n → Ω → RectangleCLT.Vector p) (K : ℝ) (A : Matrix (Fin p) (Fin p) ℝ),
