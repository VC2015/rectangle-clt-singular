  RectangleCLT.Companion.SplitV4.ConditionalTranslatedCoefficientBudget s μ H Z (fun i α ω => Y i α ω * W i α ω) v M R
RectangleCLT.Companion.SplitV4.Printed.canonical_hessian_taylor_triangle {p : ℕ} {F : RectangleCLT.Vector p → ℝ}
  (hF : ContDiff ℝ 4 F) (x z : RectangleCLT.Vector p) (a v : ℝ) :
  RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 (x + (a * v) • z) z -
      (RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 x z +
        v * a * RectangleCLT.Companion.SplitV4.canonicalDiagonal F 3 x z) =
    a ^ 2 * ∫ (s : ℝ) in 0 ..v, (v - s) * RectangleCLT.Companion.SplitV4.canonicalDiagonal F 4 (x + (a * s) • z) z
RectangleCLT.Companion.SplitV4.Printed.centered_gradient_hessian_identity.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] {F : RectangleCLT.Vector p → ℝ}
  (hF : ContDiff ℝ 4 F) {C δ : ℝ} (hC : 0 ≤ C) (hδ : 0 ≤ δ)
  (hjet : ∀ (k : ℕ), 1 ≤ k → k ≤ 4 → ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C)
  (T : Ω → RectangleCLT.Vector p) (hT : Measurable T) (hbound : ∀ᵐ (ω : Ω) ∂μ, ‖T ω‖ ≤ δ)
  (hc : ∀ (j : Fin p), ∫ (ω : Ω), T ω j ∂μ = 0) (x : RectangleCLT.Vector p) (a : ℝ) :
  ∫ (ω : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 1 (x + a • T ω) (T ω) ∂μ =
    a * ∫ (r : ℝ) in 0 ..1, ∫ (ω : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 (x + (a * r) • T ω) (T ω) ∂μ
RectangleCLT.Companion.SplitV4.Printed.centered_value_hessian_identity.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] {p : ℕ}
  (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] {F : RectangleCLT.Vector p → ℝ}
  (hF : ContDiff ℝ 4 F) {C δ : ℝ} (hC : 0 ≤ C) (hδ : 0 ≤ δ)
  (hjet : ∀ (k : ℕ), 1 ≤ k → k ≤ 4 → ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C)
  (T : Ω → RectangleCLT.Vector p) (hT : Measurable T) (hbound : ∀ᵐ (ω : Ω) ∂μ, ‖T ω‖ ≤ δ)
  (hc : ∀ (j : Fin p), ∫ (ω : Ω), T ω j ∂μ = 0) (x : RectangleCLT.Vector p) (a : ℝ) :
  ∫ (ω : Ω), F (x + a • T ω) ∂μ - F x =
    a ^ 2 *
      ∫ (r : ℝ) in 0 ..1,
        (1 - r) * ∫ (ω : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 (x + (a * r) • T ω) (T ω) ∂μ
RectangleCLT.Companion.SplitV4.Printed.conditional_finite_cauchy_schwarz.{u_1} {Ω : Type u_1} [mΩ : MeasurableSpace Ω]
  {n : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (H : MeasurableSpace Ω) (hH : H ≤ mΩ)
  (X Y : Fin n → Ω → ℝ) (hX : ∀ (i : Fin n), Measurable (X i)) (hY : ∀ (i : Fin n), Measurable (Y i))
  (hX2 : ∀ (i : Fin n), MeasureTheory.Integrable (fun ω => X i ω ^ 2) μ)
  (hY2 : ∀ (i : Fin n), MeasureTheory.Integrable (fun ω => Y i ω ^ 2) μ) :
  ∀ᵐ (ω : Ω) ∂μ,
    μ[fun z => ∑ i, |X i z * Y i z| |H] ω ≤ √(μ[fun z => ∑ i, X i z ^ 2|H] ω * μ[fun z => ∑ i, Y i z ^ 2|H] ω)
RectangleCLT.Companion.SplitV4.Printed.conditional_finite_pair_contraction.{u_1} {Ω : Type u_1} [mΩ : MeasurableSpace Ω]
  {n : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (H : MeasurableSpace Ω) (hH : H ≤ mΩ)
  (X Y : Fin n → Ω → ℝ) (hX : ∀ (i : Fin n), Measurable (X i)) (hY : ∀ (i : Fin n), Measurable (Y i))
  (hX2 : ∀ (i : Fin n), MeasureTheory.Integrable (fun ω => X i ω ^ 2) μ)
  (hY2 : ∀ (i : Fin n), MeasureTheory.Integrable (fun ω => Y i ω ^ 2) μ)
  (hbX : ∀ᵐ (ω : Ω) ∂μ, μ[fun z => ∑ i, X i z ^ 2|H] ω ≤ 1) (hbY : ∀ᵐ (ω : Ω) ∂μ, μ[fun z => ∑ i, Y i z ^ 2|H] ω ≤ 1) :
  ∀ᵐ (ω : Ω) ∂μ, μ[fun z => ∑ i, |X i z * Y i z| |H] ω ≤ 1
RectangleCLT.Companion.SplitV4.Printed.gaussian_unit_interval_mass_pos :
  0 < (ProbabilityTheory.gaussianReal 0 1).real (Set.Icc (-1) 1)
RectangleCLT.Companion.SplitV4.Printed.genericRowOperator_eq_signed_hessian.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] {F : RectangleCLT.Vector p → ℝ}
  (hF : ContDiff ℝ 4 F) {C δ : ℝ} (hC : 0 ≤ C) (hδ : 0 ≤ δ)
  (hjet : ∀ (k : ℕ), 1 ≤ k → k ≤ 4 → ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C)
  (T : Ω → RectangleCLT.Vector p) (hT : Measurable T) (hbound : ∀ᵐ (ω : Ω) ∂μ, ‖T ω‖ ≤ δ)
  (hc : ∀ (j : Fin p), ∫ (ω : Ω), T ω j ∂μ = 0) (x : RectangleCLT.Vector p) (γ γ' : ℝ → ℝ) {t : ℝ} (hγ : γ t ≠ 0) :
  RectangleCLT.Companion.SplitV4.genericRowOperator μ F T x (γ t)
      (RectangleCLT.Companion.SplitV4.variableRetentionDerivative γ γ' t)
      (RectangleCLT.Companion.SplitV4.variableRetention γ t * γ' t) =
    -(1 / 2) *
      ∫ (r : ℝ) in 0 ..1,
        RectangleCLT.Companion.SplitV4.signedDensity (RectangleCLT.Companion.SplitV4.variableEta γ γ' t) r *
          ∫ (u : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 (x + (γ t * r) • T u) (T u) ∂μ
RectangleCLT.Companion.SplitV4.Printed.genericRowOperator_fourth_from_signed_hessian.{u_1} {Ω : Type u_1}
  [MeasurableSpace Ω] {p : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
  {F : RectangleCLT.Vector p → ℝ} (hF : ContDiff ℝ 4 F) {C δ : ℝ} (hC : 0 ≤ C) (hδ : 0 ≤ δ)
  (hjet : ∀ (k : ℕ), 1 ≤ k → k ≤ 4 → ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C)
  (T : Ω → RectangleCLT.Vector p) (hT : Measurable T) (hbound : ∀ᵐ (ω : Ω) ∂μ, ‖T ω‖ ≤ δ)
  (hc : ∀ (j : Fin p), ∫ (ω : Ω), T ω j ∂μ = 0) (x : RectangleCLT.Vector p) (γ γ' : ℝ → ℝ) {t : ℝ} (hγ : γ t ≠ 0) :
  RectangleCLT.Companion.SplitV4.genericRowOperator μ F T x (γ t)
      (RectangleCLT.Companion.SplitV4.variableRetentionDerivative γ γ' t)
      (RectangleCLT.Companion.SplitV4.variableRetention γ t * γ' t) =
    -(1 / 2) * ∫ (u : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 x (T u) ∂μ -
        γ t * (1 - RectangleCLT.Companion.SplitV4.variableEta γ γ' t) / 6 *
          ∫ (u : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 3 x (T u) ∂μ +
      ∫ (s : ℝ) in 0 ..1,
        RectangleCLT.Companion.SplitV4.seededFourthKernel (γ t) (RectangleCLT.Companion.SplitV4.variableEta γ γ' t) s *
          ∫ (u : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 4 (x + (γ t * s) • T u) (T u) ∂μ
RectangleCLT.Companion.SplitV4.Printed.genericSelectorOperator_eq_signedHessian.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p n : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] {F : RectangleCLT.Vector p → ℝ}
  (hF : ContDiff ℝ 4 F) {C δ : ℝ} (hC : 0 ≤ C)
  (hjet : ∀ (k : ℕ), 1 ≤ k → k ≤ 4 → ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C)
  (ξ : Fin n → Ω → RectangleCLT.Vector p) (h : RectangleCLT.BoundedIndependentHypotheses μ ξ δ)
  (A : Matrix (Fin p) (Fin p) ℝ) (hA : A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.sumVector ξ))
  (x : RectangleCLT.Vector p) (γ γ' : ℝ → ℝ) {t : ℝ} (hγ : γ t ≠ 0) :
  RectangleCLT.Companion.SplitV4.genericSelectorOperator μ F ξ (A * A.transpose) x
      (RectangleCLT.Companion.SplitV4.variableRetention γ t) (γ t)
      (RectangleCLT.Companion.SplitV4.variableRetentionDerivative γ γ' t)
      (RectangleCLT.Companion.SplitV4.variableRetention γ t * γ' t) =
    RectangleCLT.Companion.SplitV4.Printed.signedHessianSelector μ F ξ x
      (RectangleCLT.Companion.SplitV4.variableRetention γ t) (γ t) (RectangleCLT.Companion.SplitV4.variableEta γ γ' t)
RectangleCLT.Companion.SplitV4.Printed.hasDerivAt_seededExpectation_signedHessian.{u_1} {Ω : Type u_1}
  [MeasurableSpace Ω] {p n : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
  (ξ : Fin n → Ω → RectangleCLT.Vector p) {δ : ℝ} (h : RectangleCLT.BoundedIndependentHypotheses μ ξ δ)
  {F : RectangleCLT.Vector p → ℝ} (hF : ContDiff ℝ 4 F) {C : ℝ} (hC : 0 ≤ C)
  (hjet : ∀ (k : ℕ), 1 ≤ k → k ≤ 4 → ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C)
  (A : Matrix (Fin p) (Fin p) ℝ) (hA : A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.sumVector ξ))
  (γ γ' : ℝ → ℝ) {ε : ℝ} (hε : 0 ≤ ε) (hderiv : ∀ r ∈ Set.Ioo 0 1, HasDerivAt γ (γ' r) r)
  (hpos : ∀ r ∈ Set.Ioo 0 1, 0 < γ r)
  (hq : ∀ r ∈ Set.Ioo 0 1, RectangleCLT.Companion.SplitV4.variableRetention γ r ∈ Set.Icc 0 1)
  (x : RectangleCLT.Vector p) {t : ℝ} (ht : 0 < t) (ht1 : t < 1) (hcont : ContinuousAt γ' t) :
  HasDerivAt
    (fun r =>
      ∫ (y : RectangleCLT.Vector p),
        F (x + y) ∂RectangleCLT.Companion.SplitV4.variableSeededInterpolationLaw μ ξ A γ ε r)
    (∫ (g : RectangleCLT.Vector p),
      RectangleCLT.Companion.SplitV4.Printed.signedHessianSelector μ F ξ (x + √(t + ε) • g)
        (RectangleCLT.Companion.SplitV4.variableRetention γ t) (γ t)
        (RectangleCLT.Companion.SplitV4.variableEta γ γ' t) ∂RectangleCLT.gaussianLaw A)
    t
