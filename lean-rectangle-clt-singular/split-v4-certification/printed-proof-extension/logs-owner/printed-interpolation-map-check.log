  (hW : ∀ (i : Fin n) (α : Fin k → RectangleCLT.Face p), MeasureTheory.AEStronglyMeasurable (W i α) μ)
  (hv : ∀ (i : Fin n), MeasureTheory.AEStronglyMeasurable (v i) μ) {δ R M : ℝ} (hδ : 0 ≤ δ) (hR : 0 ≤ R)
  (hYb : ∀ (i : Fin n) (α : Fin k → RectangleCLT.Face p), ∀ᵐ (ω : Ω) ∂μ, |Y i α ω| ≤ δ)
  (hWb : ∀ (i : Fin n) (α : Fin k → RectangleCLT.Face p), ∀ᵐ (ω : Ω) ∂μ, |W i α ω| ≤ δ)
  (hvb : ∀ (i : Fin n), ∀ᵐ (ω : Ω) ∂μ, ‖v i ω‖ ≤ R)
