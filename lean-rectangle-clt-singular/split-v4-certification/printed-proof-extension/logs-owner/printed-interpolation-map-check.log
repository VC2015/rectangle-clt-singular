RectangleCLT.Companion.F_mul_prod_pi_translation {p : ℕ} (s : RectangleCLT.FaceSmoother p) {k : ℕ}
  (faces : Fin k → RectangleCLT.Face p) (x v : RectangleCLT.Vector p) :
  s.F (x + v) * ∏ i, s.pi (x + v) (faces i) =
    (s.F x * ∏ i, s.pi x (faces i)) * Real.exp ((∑ i, RectangleCLT.FaceSmoother.normalDot (faces i) v) / s.bandwidth) /
      (1 + RectangleCLT.Companion.translationZ s x v) ^ (k + 1)
RectangleCLT.Companion.SplitV4.C4Test.genericVariableHeatDerivative_eq_spatial_add_heat.{u_1} {p : ℕ}
  (f : RectangleCLT.Companion.SplitV4.C4Test p) {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] (V : Ω → RectangleCLT.Vector p) (hV : Measurable V) {δ : ℝ}
  (hbound : ∀ᵐ (ω : Ω) ∂μ, ‖V ω‖ ≤ δ) (A : Matrix (Fin p) (Fin p) ℝ) (γ γ' : ℝ → ℝ) (ε : ℝ) (x : RectangleCLT.Vector p)
  {t : ℝ} (ht : 0 < t + ε) :
  f.genericVariableHeatDerivative μ V A γ γ' ε x t =
    γ' t *
        ∫ (z : Ω × RectangleCLT.Vector p),
          (f.gradient (x + γ t • V z.1 + √(t + ε) • z.2)) (V z.1) ∂μ.prod (RectangleCLT.gaussianLaw A) +
      1 / 2 *
        ∑ j,
          ∑ k,
            (A * A.transpose) j k *
              ∫ (z : Ω × RectangleCLT.Vector p),
                f.hessianCoordinate (x + γ t • V z.1 + √(t + ε) • z.2) j k ∂μ.prod (RectangleCLT.gaussianLaw A)
RectangleCLT.Companion.SplitV4.C4Test.hasDerivAt_genericVariableSelectorExpectation.{u_1} {p : ℕ}
  (f : RectangleCLT.Companion.SplitV4.C4Test p) {Ω : Type u_1} [MeasurableSpace Ω] {n : ℕ} (μ : MeasureTheory.Measure Ω)
