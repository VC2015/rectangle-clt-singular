  {δ : ℝ} (hδ : 0 ≤ δ) (hbound : ∀ (i : Fin n), ∀ᵐ (ω : Ω) ∂μ, ‖ξ i ω‖ ≤ δ) (A : Matrix (Fin p) (Fin p) ℝ)
  (γ γ' : ℝ → ℝ) {ε : ℝ} (hε : 0 ≤ ε) (hderiv : ∀ r ∈ Set.Ioo 0 1, HasDerivAt γ (γ' r) r) (x : RectangleCLT.Vector p)
  {t : ℝ} (ht : 0 < t) (ht1 : t < 1) (hpos : 0 < γ t) (hcont : ContinuousAt γ' t) :
  HasDerivAt (f.genericVariableSelectorExpectation μ ξ A γ ε x) (f.genericVariableSelectorDerivative μ ξ A γ γ' ε x t) t
RectangleCLT.Companion.SplitV4.C4Test.hasDerivAt_integral_variableSeededInterpolationLaw.{u_1} {p : ℕ}
  (f : RectangleCLT.Companion.SplitV4.C4Test p) {Ω : Type u_1} [MeasurableSpace Ω] {n : ℕ} (μ : MeasureTheory.Measure Ω)
