RectangleCLT.Companion.SplitV4.Printed.signed_hessian_fourth_kernel_expectation.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] {F : RectangleCLT.Vector p → ℝ}
  (hF : ContDiff ℝ 4 F) {C δ : ℝ} (hC : 0 ≤ C) (hδ : 0 ≤ δ)
  (hjet : ∀ (k : ℕ), 1 ≤ k → k ≤ 4 → ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C)
  (T : Ω → RectangleCLT.Vector p) (hT : Measurable T) (hbound : ∀ᵐ (ω : Ω) ∂μ, ‖T ω‖ ≤ δ) (x : RectangleCLT.Vector p)
  (a η : ℝ) :
  -(1 / 2) *
      ∫ (v : ℝ) in 0 ..1,
        RectangleCLT.Companion.SplitV4.signedDensity η v *
          ∫ (u : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 (x + (a * v) • T u) (T u) ∂μ =
    -(1 / 2) * ∫ (u : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 x (T u) ∂μ -
        a * (1 - η) / 6 * ∫ (u : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 3 x (T u) ∂μ +
      ∫ (s : ℝ) in 0 ..1,
        RectangleCLT.Companion.SplitV4.seededFourthKernel a η s *
          ∫ (u : Ω), RectangleCLT.Companion.SplitV4.canonicalDiagonal F 4 (x + (a * s) • T u) (T u) ∂μ
RectangleCLT.Companion.SplitV4.Printed.signed_hessian_fourth_kernel_identity {p : ℕ} {F : RectangleCLT.Vector p → ℝ}
  (hF : ContDiff ℝ 4 F) (x z : RectangleCLT.Vector p) (a η : ℝ) :
  -(1 / 2) *
      ∫ (v : ℝ) in 0 ..1,
        RectangleCLT.Companion.SplitV4.signedDensity η v *
          RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 (x + (a * v) • z) z =
    -(1 / 2) * RectangleCLT.Companion.SplitV4.canonicalDiagonal F 2 x z -
        a * (1 - η) / 6 * RectangleCLT.Companion.SplitV4.canonicalDiagonal F 3 x z +
      ∫ (s : ℝ) in 0 ..1,
        RectangleCLT.Companion.SplitV4.seededFourthKernel a η s *
          RectangleCLT.Companion.SplitV4.canonicalDiagonal F 4 (x + (a * s) • z) z
RectangleCLT.Companion.SplitV4.Printed.weighted_triangle_integral_swap (K g : ℝ → ℝ) (hK : Continuous K)
  (hg : Continuous g) :
  ∫ (v : ℝ) in 0 ..1, K v * ∫ (s : ℝ) in 0 ..v, (v - s) * g s =
    ∫ (s : ℝ) in 0 ..1, (∫ (v : ℝ) in s..1, (v - s) * K v) * g s
RectangleCLT.Companion.SplitV4.Printed.zero_order_local_envelope_fails {C : ℝ} (hC : 0 ≤ C) :
