  {δ : ℝ} (hδ : 0 ≤ δ) (hbound : ∀ (i : Fin n), ∀ᵐ (ω : Ω) ∂μ, ‖ξ i ω‖ ≤ δ) (A : Matrix (Fin p) (Fin p) ℝ)
  (γ γ' : ℝ → ℝ) {ε : ℝ} (hε : 0 ≤ ε) (hderiv : ∀ r ∈ Set.Ioo 0 1, HasDerivAt γ (γ' r) r)
  (hpos : ∀ r ∈ Set.Ioo 0 1, 0 < γ r)
  (hq : ∀ r ∈ Set.Ioo 0 1, RectangleCLT.Companion.SplitV4.variableRetention γ r ∈ Set.Icc 0 1)
  (x : RectangleCLT.Vector p) {t : ℝ} (ht : 0 < t) (ht1 : t < 1) (hcont : ContinuousAt γ' t) :
  HasDerivAt
    (fun r =>
      ∫ (y : RectangleCLT.Vector p),
        f.value (x + y) ∂RectangleCLT.Companion.SplitV4.variableSeededInterpolationLaw μ ξ A γ ε r)
    (f.genericVariableSelectorDerivative μ ξ A γ γ' ε x t) t
RectangleCLT.Companion.SplitV4.ConditionalTranslatedCoefficientBudget.relative_pair.{u_1} {Ω : Type u_1}
