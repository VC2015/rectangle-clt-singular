RectangleCLT.Companion.SplitV4.slepian_fourth_kernel (gamma s : ℝ) :
  RectangleCLT.Companion.SplitV4.seededFourthKernel gamma (-1 / 2) s = -gamma ^ 2 / 4 * (1 - s) ^ 2
RectangleCLT.Companion.SplitV4.smallerEnvelope_scaled_bounded_component.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p n : ℕ} [NeZero p] (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
  (ξ : Fin n → Ω → RectangleCLT.Vector p) {δ : ℝ} (h : RectangleCLT.BoundedIndependentHypotheses μ ξ δ)
  (hunit : ∀ (j : Fin p), RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) j j = 1)
  (s : RectangleCLT.FaceSmoother p) (hfaces : s.faces = Finset.univ) (hband : 4 * δ ≤ s.bandwidth) (a : ℝ) (ha : 0 ≤ a)
  (ha2 : a ≤ 2) (hav : 1 / 2 ≤ a ^ 2) (r : RectangleCLT.Vector p) :
  ∫ (ω : Ω), s.F (a • RectangleCLT.sumVector ξ ω + r) * (1 - s.F (a • RectangleCLT.sumVector ξ ω + r)) ∂μ ≤
    RectangleCLT.Companion.SplitV4.derivativeEnvelopeSignedAverageConstant * s.bandwidth *
      √(RectangleCLT.dimensionLog p)
RectangleCLT.Companion.SplitV4.smallerEnvelope_scaled_gaussian_component {p : ℕ} [NeZero p]
  (A : Matrix (Fin p) (Fin p) ℝ) (hunit : ∀ (j : Fin p), (A * A.transpose) j j = 1) (s : RectangleCLT.FaceSmoother p)
  (hfaces : s.faces = Finset.univ) (a : ℝ) (hav : 1 / 2 ≤ a ^ 2) (r : RectangleCLT.Vector p) :
  ∫ (g : RectangleCLT.Vector p), s.F (a • g + r) * (1 - s.F (a • g + r)) ∂RectangleCLT.gaussianLaw A ≤
    RectangleCLT.Companion.SplitV4.derivativeEnvelopeSignedAverageConstant * s.bandwidth *
      √(RectangleCLT.dimensionLog p)
RectangleCLT.Companion.SplitV4.smoother_gap_le_actual_two_stage_gaps.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] {p n : ℕ}
  (s : RectangleCLT.FaceSmoother p) (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
  (ξ : Fin n → Ω → RectangleCLT.Vector p) (hξ : ∀ (i : Fin n), Measurable (ξ i)) (A : Matrix (Fin p) (Fin p) ℝ) {ε : ℝ}
  (hε : 0 ≤ ε) :
  |∫ (ω : Ω), s.F (RectangleCLT.sumVector ξ ω) ∂μ - ∫ (g : RectangleCLT.Vector p), s.F g ∂RectangleCLT.gaussianLaw A| ≤
    |∫ (ω : Ω), s.F (RectangleCLT.sumVector ξ ω) ∂μ -
          RectangleCLT.Companion.SplitV4.directSlepianExpectation s μ ξ A
            (RectangleCLT.Companion.SplitV4.seededInitializationTime ε)| +
      |∫ (y : RectangleCLT.Vector p), s.F y ∂RectangleCLT.Companion.SplitV4.normalizedSeededInterpolationLaw μ ξ A ε 1 -
          ∫ (y : RectangleCLT.Vector p),
            s.F y ∂RectangleCLT.Companion.SplitV4.normalizedSeededInterpolationLaw μ ξ A ε 0|
RectangleCLT.Companion.SplitV4.sum_mask_genericBernoulliMoment_commonPoint.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p n k : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
  (ξ : Fin n → Ω → RectangleCLT.Vector p) {δ : ℝ} (h : RectangleCLT.BoundedIndependentHypotheses μ ξ δ)
  {F : RectangleCLT.Vector p → ℝ} (hF : ContDiff ℝ 4 F) (hk : k ≤ 4) {C : ℝ} (hC : 0 ≤ C)
  (hjet : ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C) (i : Fin n) (x : RectangleCLT.Vector p)
  (q a : ℝ) :
  ∑ mask,
      Kane.maskWeight q mask *
        ∫ (ω : Ω),
          RectangleCLT.Companion.SplitV4.genericBernoulliMoment μ F k (ξ i)
            (x + a • RectangleCLT.maskObservationSum ξ (Function.update mask i false) ω) q a ∂μ =
    ∑ mask,
      Kane.maskWeight q mask *
        ∫ (ω : Ω),
          ∫ (u : Ω),
            RectangleCLT.Companion.SplitV4.canonicalDiagonal F k (x + a • RectangleCLT.maskObservationSum ξ mask ω)
              (ξ i u) ∂μ ∂μ
RectangleCLT.Companion.SplitV4.translatedFaceDerivativeSupremum_le {m r q : ℕ} (F : RectangleCLT.Vector r → ℝ)
  (U : Matrix (Fin m) (Fin r) ℝ) {ρ : ℝ} (hρ : 0 ≤ ρ) (z : Fin q → RectangleCLT.Vector r)
  (B : RectangleCLT.Vector r → ℝ)
  (hbound :
    ∀ (x v : RectangleCLT.Vector r),
      RectangleCLT.Companion.SplitV4.faceProjectionNorm U v ≤ ρ → ‖(iteratedFDeriv ℝ q F (x + v)) z‖ ≤ B x)
  (x : RectangleCLT.Vector r) : RectangleCLT.Companion.SplitV4.translatedFaceDerivativeSupremum F U ρ z x ≤ B x
RectangleCLT.Companion.SplitV4.translated_score_array_series_interchange.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p r n k : ℕ} (s : RectangleCLT.FaceSmoother p) (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
  (A : Matrix (Fin p) (Fin r) ℝ) (V : Ω → RectangleCLT.Vector p) (hV : Measurable V)
  (Z : Fin n → Ω → RectangleCLT.Vector r) (hZm : ∀ (i : Fin n), Measurable (Z i))
  (hZ : ∀ (i : Fin n) (j l : Fin r), MeasureTheory.Integrable (fun ω => Z i ω j * Z i ω l) μ)
  (c : Fin n → (Fin k → RectangleCLT.Face p) → Ω → ℝ)
  (hc : ∀ (i : Fin n) (α : Fin k → RectangleCLT.Face p), Measurable (c i α)) (v : Fin n → Ω → RectangleCLT.Vector p)
  (hv : ∀ (i : Fin n), Measurable (v i)) {b R : ℝ} (hb : 0 ≤ b) (hR : 0 ≤ R)
  (hcb : ∀ (i : Fin n) (α : Fin k → RectangleCLT.Face p), ∀ᵐ (ω : Ω) ∂μ, |c i α ω| ≤ b)
  (hvb : ∀ (i : Fin n), ∀ᵐ (ω : Ω) ∂μ, ‖v i ω‖ ≤ R) (hsmall : R / s.bandwidth < Real.log 2) :
  MeasureTheory.Integrable
      (fun z =>
        ∑ i,
          ∑ α,
            c i α z.1 * RectangleCLT.Companion.repeatedDirectionScore z.2 (Z i z.1) *
              RectangleCLT.Companion.selectorTupleWeight s α (A.mulVec z.2 + V z.1 + v i z.1))
      (μ.prod (RectangleCLT.standardGaussian r)) ∧
    (∀ (ℓ : ℕ),
        MeasureTheory.Integrable
          (fun z =>
            ∑ i,
              ∑ α,
                c i α z.1 * RectangleCLT.Companion.repeatedDirectionScore z.2 (Z i z.1) *
                  RectangleCLT.Companion.restorationSeriesTerm s α (A.mulVec z.2 + V z.1) (v i z.1) ℓ)
          (μ.prod (RectangleCLT.standardGaussian r))) ∧
      HasSum
        (fun ℓ =>
          ∫ (z : Ω × RectangleCLT.Vector r),
            ∑ i,
              ∑ α,
                c i α z.1 * RectangleCLT.Companion.repeatedDirectionScore z.2 (Z i z.1) *
                  RectangleCLT.Companion.restorationSeriesTerm s α (A.mulVec z.2 + V z.1) (v i z.1)
                    ℓ ∂μ.prod (RectangleCLT.standardGaussian r))
        (∫ (z : Ω × RectangleCLT.Vector r),
          ∑ i,
            ∑ α,
              c i α z.1 * RectangleCLT.Companion.repeatedDirectionScore z.2 (Z i z.1) *
                RectangleCLT.Companion.selectorTupleWeight s α
                  (A.mulVec z.2 + V z.1 + v i z.1) ∂μ.prod (RectangleCLT.standardGaussian r))
RectangleCLT.Companion.SplitV4.translationD1_eq_selector_partition {p : ℕ} (s : RectangleCLT.FaceSmoother p)
  (x y : RectangleCLT.Vector p) :
  s.translationD1 x y =
    -(1 / s.bandwidth) *
      ∑ α, RectangleCLT.FaceSmoother.normalDot (α 0) y * RectangleCLT.Companion.selectorTupleWeight s α x
RectangleCLT.Companion.SplitV4.uniformBoundaryConcentration_seededSplitBase.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p n : ℕ} {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsProbabilityMeasure μ] {ξ : Fin n → Ω → RectangleCLT.Vector p}
  {δ : ℝ} (hdata : RectangleCLT.BoundedIndependentHypotheses μ ξ δ) (hp : 1 ≤ p)
  (hunit : ∀ (j : Fin p), RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) j j = 1) (A : Matrix (Fin p) (Fin p) ℝ)
  (hA : A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.sumVector ξ)) (x : RectangleCLT.Vector p) {ε t : ℝ}
  (hε : 0 ≤ ε) (ht : 0 ≤ t) (ht1 : t ≤ 1) :
  RectangleCLT.Companion.SignedSurface.UniformBoundaryConcentration
    (RectangleCLT.Companion.SplitV4.seededSplitBaseDistribution μ ξ A x ε t)
    RectangleCLT.Companion.splitBoundaryConstant (2 * δ) (1 / 4)
RectangleCLT.Companion.SplitV4.variableEta_slepianAmplitude {v : ℝ} (hv : v < 1) :
  RectangleCLT.Companion.SplitV4.variableEta RectangleCLT.Companion.SplitV4.slepianAmplitude
      RectangleCLT.Companion.SplitV4.slepianAmplitudeDerivative v =
    -(1 / 2)
RectangleCLT.Companion.SplitV4.variableSeededInterpolationLaw.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] {p n : ℕ}
  (μ : MeasureTheory.Measure Ω) (ξ : Fin n → Ω → RectangleCLT.Vector p) (A : Matrix (Fin p) (Fin p) ℝ) (γ : ℝ → ℝ)
  (ε t : ℝ) : MeasureTheory.Measure (RectangleCLT.Vector p)
RectangleCLT.Companion.SplitV4.variableSeededInterpolationLaw_isProbability.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {p n : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (ξ : Fin n → Ω → RectangleCLT.Vector p)
  (hξ : ∀ (i : Fin n), Measurable (ξ i)) (A : Matrix (Fin p) (Fin p) ℝ) (γ : ℝ → ℝ) (ε t : ℝ)
  (hq : RectangleCLT.Companion.SplitV4.variableRetention γ t ∈ Set.Icc 0 1) :
  MeasureTheory.IsProbabilityMeasure (RectangleCLT.Companion.SplitV4.variableSeededInterpolationLaw μ ξ A γ ε t)
RectangleCLT.Companion.SplitV4.variable_covariance_calibration (γ : ℝ → ℝ) {t : ℝ} (hγ : γ t ≠ 0) :
  RectangleCLT.Companion.SplitV4.variableRetention γ t * γ t ^ 2 = 1 - t
RectangleCLT.Companion.SplitV4.variable_cubic_coefficient (γ γ' : ℝ → ℝ) {t : ℝ} (hγ : γ t ≠ 0) :
  -γ t * (1 - RectangleCLT.Companion.SplitV4.variableEta γ γ' t) / 6 = (-γ t + (1 - t) * γ' t) / 6
RectangleCLT.Companion.SplitV4.variable_signed_hessian_coefficient (γ γ' : ℝ → ℝ) {t : ℝ} (hγ : γ t ≠ 0) (r : ℝ) :
  RectangleCLT.Companion.SplitV4.variableRetentionDerivative γ γ' t * γ t ^ 2 * (1 - r) +
      RectangleCLT.Companion.SplitV4.variableRetention γ t * γ t * γ' t =
    -RectangleCLT.Companion.SplitV4.signedDensity (RectangleCLT.Companion.SplitV4.variableEta γ γ' t) r / 2
RectangleCLT.Companion.abs_restorationTranslationCoefficient_le {p : ℕ} (s : RectangleCLT.FaceSmoother p) {k ℓ : ℕ}
  (α : Fin k → RectangleCLT.Face p) (β : Fin ℓ → RectangleCLT.Face p) {v : RectangleCLT.Vector p} {R : ℝ} (_hR : 0 ≤ R)
  (hv : ‖v‖ ≤ R) :
  |RectangleCLT.Companion.restorationTranslationCoefficient s α β v| ≤
    Real.exp (↑k * R / s.bandwidth) * (Real.exp (R / s.bandwidth) - 1) ^ ℓ
RectangleCLT.Companion.hasSum_restorationSeriesTerm {p : ℕ} (s : RectangleCLT.FaceSmoother p) {k : ℕ}
  (α : Fin k → RectangleCLT.Face p) (x : RectangleCLT.Vector p) {v : RectangleCLT.Vector p} {R : ℝ} (hR : 0 ≤ R)
  (hv : ‖v‖ ≤ R) (hsmall : R / s.bandwidth < Real.log 2) :
  HasSum (RectangleCLT.Companion.restorationSeriesTerm s α x v) (RectangleCLT.Companion.selectorTupleWeight s α (x + v))
RectangleCLT.Companion.restorationTranslationCoefficient {p : ℕ} (s : RectangleCLT.FaceSmoother p) {k ℓ : ℕ}
  (α : Fin k → RectangleCLT.Face p) (β : Fin ℓ → RectangleCLT.Face p) (v : RectangleCLT.Vector p) : ℝ
RectangleCLT.FaceSmoother.F_eq_exponential_probability {p : ℕ} (s : RectangleCLT.FaceSmoother p) (x : Fin p → ℝ) :
  s.F x = (RectangleCLT.exponentialRectangleLaw p).real (s.exponentialEvent x)
RectangleCLT.FaceSmoother.integral_F_eq_randomRectangle_average {p : ℕ} (s : RectangleCLT.FaceSmoother p)
  (μ : MeasureTheory.Measure (Fin p → ℝ)) [MeasureTheory.IsProbabilityMeasure μ] :
  ∫ (x : Fin p → ℝ), s.F x ∂μ =
    ∫ (e : ℝ × (RectangleCLT.Face p → ℝ)),
      μ.real {x | (s.randomRectangle e).Inside x} ∂RectangleCLT.exponentialRectangleLaw p
RectangleCLT.maskObservationSum_bounded.{u} {Ω : Type u} [MeasurableSpace Ω] {p n : ℕ} (μ : MeasureTheory.Measure Ω)
  (ξ : Fin n → Ω → RectangleCLT.Vector p) {δ : ℝ} (hδ : 0 ≤ δ) (hbound : ∀ (i : Fin n), ∀ᵐ (ω : Ω) ∂μ, ‖ξ i ω‖ ≤ δ)
  (mask : Kane.Cube n) : ∀ᵐ (ω : Ω) ∂μ, ‖RectangleCLT.maskObservationSum ξ mask ω‖ ≤ ↑n * δ
