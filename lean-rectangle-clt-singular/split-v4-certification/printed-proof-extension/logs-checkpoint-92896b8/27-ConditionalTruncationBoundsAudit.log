def RectangleCLT.Companion.SplitV4.truncationVarianceBudget : ℝ → ℝ → ℝ → ℝ :=
fun B T q => B ^ q * T ^ (2 - q)
def RectangleCLT.Companion.SplitV4.conditionalCovarianceForMask : {p n : ℕ} →
  (Fin n → MeasureTheory.Measure (RectangleCLT.Vector p)) → ℝ → (Fin n → Bool) → Matrix (Fin p) (Fin p) ℝ :=
fun {p n} μ T mask j k =>
  1 / ↑n *
    ∑ i,
      if mask i = true then 0
      else RectangleCLT.covariance (RectangleCLT.Companion.SplitV4.goodConditionalLaw (μ i) T) id j k
def RectangleCLT.Companion.SplitV4.originalAverageCovariance : {p n : ℕ} →
  (Fin n → MeasureTheory.Measure (RectangleCLT.Vector p)) → Matrix (Fin p) (Fin p) ℝ :=
fun {p n} μ j k => 1 / ↑n * ∑ i, RectangleCLT.covariance (μ i) id j k
