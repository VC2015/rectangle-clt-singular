        MeasureTheory.Measure Ω → (Fin n → Ω → RectangleCLT.Vector p) → RectangleCLT.Vector p → ℝ :=
fun {Ω} [MeasurableSpace Ω] {p n} s μ ξ x =>
  ∑ j, ∑ k, ∑ l, RectangleCLT.Companion.SplitV4.relativeThirdMatrix μ ξ j k l * s.mixedThirdDerivativeF x j k l
