  {p n : ℕ} → (Fin n → Ω → RectangleCLT.Vector p) → Fin n → Bool → Ω × Ω → RectangleCLT.Vector p :=
fun {Ω} {p n} ξ i b z j => RectangleCLT.Companion.SplitV4.directCopyCoordinate ξ i j b z
def RectangleCLT.Companion.SplitV4.signedCoordinateFaceEquiv : (p : ℕ) → Fin (2 * p) ≃ RectangleCLT.Face p :=
fun p => Fintype.equivOfCardEq ⋯
def RectangleCLT.Companion.SplitV4.signedCoordinateRows : (p : ℕ) → Matrix (Fin (2 * p)) (Fin p) ℝ :=
fun p α =>
  if ((RectangleCLT.Companion.SplitV4.signedCoordinateFaceEquiv p) α).2 = true then
    RectangleCLT.FaceSmoother.coordinateDirection ((RectangleCLT.Companion.SplitV4.signedCoordinateFaceEquiv p) α).1
  else -RectangleCLT.FaceSmoother.coordinateDirection ((RectangleCLT.Companion.SplitV4.signedCoordinateFaceEquiv p) α).1
