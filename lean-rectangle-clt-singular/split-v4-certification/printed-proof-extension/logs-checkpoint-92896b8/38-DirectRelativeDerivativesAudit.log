        MeasureTheory.Measure Ω → (Fin n → Ω → RectangleCLT.Vector p) → Matrix (Fin p) (Fin p) ℝ → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] {p n} s μ ξ A v =>
  ∫ (r : ℝ) in 0 ..1,
    RectangleCLT.Companion.SplitV4.genericManuscriptFourthPathIntegrand μ (RectangleCLT.gaussianLaw A) s.F ξ 0 1
      (√(1 - v)) (√v) (-(1 / 2)) v r
