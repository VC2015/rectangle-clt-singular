  {p n : ℕ} → (Fin n → Ω → RectangleCLT.Vector p) → Fin n → Fin p → Bool → Ω × Ω → ℝ :=
fun {Ω} {p n} ξ i j b z => if b = true then ξ i z.2 j else ξ i z.1 j
