        (RectangleCLT.Companion.SplitV4.seededInitializationTime (RectangleCLT.dimensionLog p * h ^ 2))|
def RectangleCLT.Companion.SplitV4.initializationDiscrepancy.{u_1} : {Ω : Type u_1} →
