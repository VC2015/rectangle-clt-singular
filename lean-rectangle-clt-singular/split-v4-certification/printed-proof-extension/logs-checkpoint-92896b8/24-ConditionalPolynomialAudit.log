def RectangleCLT.Companion.SplitV4.conditionalPolynomialConstant : ℝ :=
1 + 8 * RectangleCLT.Companion.companionUniversalConstant +
      3 * RectangleCLT.Companion.SplitV4.unrestrictedGaussianComparisonConstant +
    24 * Real.exp (3 / 2) * RectangleCLT.Companion.SplitV4.envelopeMaximumConstant +
  12
def RectangleCLT.Companion.SplitV4.conditionalPolynomialThresholdRate : ℕ → ℕ → ℝ → ℝ → ℝ → ℝ :=
fun n p B T q =>
  T / √↑n * RectangleCLT.dimensionLog p ^ (3 / 2) * √(RectangleCLT.dimensionLog n) +
      RectangleCLT.dimensionLog p * √(RectangleCLT.Companion.SplitV4.truncationVarianceBudget B T q) +
    RectangleCLT.Companion.SplitV4.polynomialEnvelopeV n p B q
def RectangleCLT.Companion.SplitV4.truncationVarianceBudget : ℝ → ℝ → ℝ → ℝ :=
fun B T q => B ^ q * T ^ (2 - q)
def RectangleCLT.Companion.SplitV4.polynomialEnvelopeV : ℕ → ℕ → ℝ → ℝ → ℝ :=
fun n p B q => B * RectangleCLT.dimensionLog p ^ (3 / 2 - 1 / q) / ↑n ^ (1 / 2 - 1 / q)
