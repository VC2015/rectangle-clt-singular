def RectangleCLT.Companion.SplitV4.symmetricTraceUnitBall : {r : ℕ} → Matrix (Fin r) (Fin r) ℝ → Prop :=
fun {r} B =>
  B.IsSymm ∧
    (∀ (z : Fin r → ℝ), |RectangleCLT.matrixQuadratic B z| ≤ RectangleCLT.vectorNormSq z) ∧ ∀ (j k : Fin r), |B j k| ≤ 1
def RectangleCLT.Companion.SplitV4.symmetricNuclearNorm : {r : ℕ} → Matrix (Fin r) (Fin r) ℝ → ℝ :=
fun {r} M => sSup {t | ∃ B, RectangleCLT.Companion.SplitV4.symmetricTraceUnitBall B ∧ t = (B * M).trace}
def RectangleCLT.Companion.SplitV4.logisticNullWeight : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → ℝ → RectangleCLT.Vector r → ℝ :=
fun {m r} u a h x => 1 / (1 + ∑ j, Real.exp ((RectangleCLT.faceDot (u j) x - a j) / h))
def RectangleCLT.Companion.SplitV4.logisticFaceWeight : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → ℝ → RectangleCLT.Vector r → Fin m → ℝ :=
fun {m r} u a h x j =>
  Real.exp ((RectangleCLT.faceDot (u j) x - a j) / h) * RectangleCLT.Companion.SplitV4.logisticNullWeight u a h x
def RectangleCLT.Companion.SplitV4.logisticTupleWeight : {m r k : ℕ} →
  (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → ℝ → (Fin k → Fin m) → RectangleCLT.Vector r → ℝ :=
fun {m r k} u a h α x =>
  RectangleCLT.Companion.SplitV4.logisticNullWeight u a h x *
    ∏ i, RectangleCLT.Companion.SplitV4.logisticFaceWeight u a h x (α i)
def RectangleCLT.Companion.SplitV4.logisticGaussianScore : {m r k : ℕ} →
  (Fin m → RectangleCLT.Vector r) →
    RectangleCLT.Vector m → ℝ → ℝ → (Fin k → Fin m) → RectangleCLT.Vector r → Matrix (Fin r) (Fin r) ℝ :=
fun {m r k} u a h σ α x =>
  RectangleCLT.Companion.weightedScore (RectangleCLT.standardGaussian r) id fun g =>
    RectangleCLT.Companion.SplitV4.logisticTupleWeight u a h α (x + σ • g)
def RectangleCLT.Companion.SplitV4.PolyhedralBaseConcentration : {r m : ℕ} →
  MeasureTheory.Measure (RectangleCLT.Vector r) → (Fin m → RectangleCLT.Vector r) → ℝ → ℝ → ℝ → Prop :=
fun {r m} μ u C δ L =>
  ∀ (a : RectangleCLT.Vector m) (s : ℝ),
    0 < s → μ.real (RectangleCLT.Companion.SplitV4.gaussianPolyhedronLayer u a s) ≤ C * (s + δ) * √L
def RectangleCLT.Companion.SplitV4.logisticPaddedNormals : {r m : ℕ} →
  (Fin m → RectangleCLT.Vector r) → ℝ → Fin m → RectangleCLT.Vector (r + m) :=
fun {r m} u lam j => Fin.append (RectangleCLT.Companion.SplitV4.logisticRegularizationScale lam • u j) (Pi.single j lam)
def RectangleCLT.Companion.SplitV4.logisticPaddedBase : {r m : ℕ} →
  ℝ → RectangleCLT.Vector r → RectangleCLT.Vector (r + m) :=
fun {r m} lam x => Fin.append ((RectangleCLT.Companion.SplitV4.logisticRegularizationScale lam)⁻¹ • x) 0
