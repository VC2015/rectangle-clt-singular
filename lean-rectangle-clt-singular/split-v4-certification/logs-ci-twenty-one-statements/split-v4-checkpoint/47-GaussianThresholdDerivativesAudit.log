def RectangleCLT.Companion.SplitV4.gaussianThresholdCDF : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → ℝ :=
fun {m r} u b => (RectangleCLT.standardGaussian r).real {g | ∀ (j : Fin m), RectangleCLT.faceDot (u j) g ≤ b j}
def RectangleCLT.Companion.SplitV4.gaussianThresholdFirst : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → Fin m → ℝ :=
fun {m r} u b j => deriv (fun t => RectangleCLT.Companion.SplitV4.gaussianThresholdCDF u (Function.update b j t)) (b j)
def RectangleCLT.Companion.SplitV4.gaussianThresholdMixed : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → Fin m → Fin m → ℝ :=
fun {m r} u b j l =>
  deriv (fun t => RectangleCLT.Companion.SplitV4.gaussianThresholdFirst u (Function.update b l t) j) (b l)
def RectangleCLT.Companion.SplitV4.gaussianThresholdSectionProbability : {m r : ℕ} →
  Finset (Fin m) → (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → RectangleCLT.Vector r → ℝ → ℝ :=
fun {m r} s v b u t =>
  RectangleCLT.Companion.SplitV4.gaussianFiniteThresholdCDF s
    (fun j => RectangleCLT.Companion.SplitV4.gaussianNormalProjection u (v j)) fun j =>
    b j - t * RectangleCLT.faceDot (v j) u
def RectangleCLT.Companion.SplitV4.gaussianNormalProjection : {r : ℕ} →
  RectangleCLT.Vector r → RectangleCLT.Vector r → RectangleCLT.Vector r :=
fun {r} u v => v - RectangleCLT.faceDot v u • u
def RectangleCLT.Companion.SplitV4.gaussianThresholdMixedSection : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → RectangleCLT.Vector m → Fin m → Fin m → ℝ :=
fun {m r} u b j l =>
  let σ := RectangleCLT.Companion.SplitV4.gaussianThresholdResidualScale u j l;
  let v := RectangleCLT.Companion.SplitV4.gaussianThresholdResidualNormals u j;
  let d := RectangleCLT.Companion.SplitV4.gaussianThresholdResidualLevels u b j;
  ProbabilityTheory.gaussianPDFReal 0 1 (b j) *
    (ProbabilityTheory.gaussianPDFReal 0 1 (d l / σ) / σ *
      RectangleCLT.Companion.SplitV4.gaussianThresholdSectionProbability ((Finset.univ.erase j).erase l) v d (σ⁻¹ • v l)
        (d l / σ))
def RectangleCLT.Companion.SplitV4.gaussianThresholdResidualScale : {m r : ℕ} →
  (Fin m → RectangleCLT.Vector r) → Fin m → Fin m → ℝ :=
fun {m r} u j l => √(RectangleCLT.vectorNormSq (RectangleCLT.Companion.SplitV4.gaussianThresholdResidualNormals u j l))
