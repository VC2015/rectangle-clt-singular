def RectangleCLT.Companion.SplitV4.bennettCorrection : ℝ → ℝ :=
fun a => Real.exp a - 1 - a
def RectangleCLT.Companion.SplitV4.bennettKernel : ℝ → ℝ :=
fun a => ∫ (r : ℝ) in 0 ..1, (1 - r) * Real.exp (r * a)
def RectangleCLT.Companion.SplitV4.bennettTruncate : {p : ℕ} → ℝ → RectangleCLT.Vector p → RectangleCLT.Vector p :=
fun {p} u x => if ‖x‖ ≤ u then x else 0
def RectangleCLT.dimensionLog : ℕ → ℝ :=
fun p => Real.log (Real.exp 1 * ↑p)
