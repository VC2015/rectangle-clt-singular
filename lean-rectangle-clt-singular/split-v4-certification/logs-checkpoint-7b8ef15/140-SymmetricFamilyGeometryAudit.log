def RectangleCLT.Companion.SplitV4.additiveGridFactor : (m : ℕ) → ℝ → ℝ → Matrix (Fin m × Fin m) (Fin m ⊕ Fin m) ℝ :=
fun m a b ju => Sum.elim (fun j => if ju.1 = j then a else 0) fun u => if ju.2 = u then b else 0
def RectangleCLT.Companion.SplitV4.additiveGridKernelVector : (m : ℕ) → ℝ → ℝ → Fin m ⊕ Fin m → ℝ :=
fun m a b => Sum.elim (fun x => -b) fun x => a
def RectangleCLT.Companion.SplitV4.familyPairCovariance : (m : ℕ) → ℝ → Matrix (Fin m × Fin m) (Fin m × Fin m) ℝ :=
fun m v ju ju' => ((1 - v) * if ju.1 = ju'.1 then 1 else 0) + v * if ju.2 = ju'.2 then 1 else 0
def RectangleCLT.Companion.SplitV4.familyCovariance : (m : ℕ) → ℝ → Matrix (Fin (m * m)) (Fin (m * m)) ℝ :=
fun m v r r' =>
  let ju := finProdFinEquiv.symm r;
  let ju' := finProdFinEquiv.symm r';
  ((1 - v) * if ju.1 = ju'.1 then 1 else 0) + v * if ju.2 = ju'.2 then 1 else 0
