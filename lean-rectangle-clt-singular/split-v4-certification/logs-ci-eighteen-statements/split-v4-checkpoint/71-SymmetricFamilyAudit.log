  (m : ℕ) → MeasureTheory.Measure (RectangleCLT.Companion.SplitV4.FamilySeed m) :=
fun P m => (RectangleCLT.Companion.SplitV4.familySignLaw m).prod (RectangleCLT.Companion.SplitV4.familyRestLaw P m)
