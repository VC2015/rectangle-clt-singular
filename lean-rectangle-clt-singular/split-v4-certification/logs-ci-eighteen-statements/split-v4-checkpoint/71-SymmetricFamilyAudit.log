def RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters.variance : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters →
  ℝ :=
fun P => P.theta * P.pi * P.amplitude ^ 2
def RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters.scale : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters →
  ℝ :=
fun P => √(1 - P.variance)
def RectangleCLT.Companion.SplitV4.familyBernoulli : RectangleCLT.Companion.SplitV4.FamilyProbability →
  MeasureTheory.Measure Bool :=
fun t =>
  ENNReal.ofReal (1 - ↑t) • MeasureTheory.Measure.dirac false + ENNReal.ofReal ↑t • MeasureTheory.Measure.dirac true
def RectangleCLT.Companion.SplitV4.familySignLaw : (m : ℕ) →
