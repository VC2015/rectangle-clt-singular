  (n m : ℕ) → MeasureTheory.Measure (Fin n → RectangleCLT.Companion.SplitV4.FamilySeed m) :=
fun P n m => MeasureTheory.Measure.pi fun x => RectangleCLT.Companion.SplitV4.familySeedLaw P m
def RectangleCLT.Companion.SplitV4.familyActivated : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters →
  {m : ℕ} →
    RectangleCLT.Companion.SplitV4.FamilySigns m × Bool × RectangleCLT.Companion.SplitV4.FamilySigns m → Fin m → ℝ :=
fun P {m} z u =>
