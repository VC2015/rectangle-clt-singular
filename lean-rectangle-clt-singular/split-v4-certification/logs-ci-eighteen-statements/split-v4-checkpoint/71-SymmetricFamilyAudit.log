def RectangleCLT.Companion.SplitV4.familyMaskLaw : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters →
  (m : ℕ) → MeasureTheory.Measure (RectangleCLT.Companion.SplitV4.FamilySigns m) :=
fun P m =>
