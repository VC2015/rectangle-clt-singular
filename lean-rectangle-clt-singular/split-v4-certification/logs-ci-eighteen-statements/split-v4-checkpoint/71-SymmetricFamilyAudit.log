def RectangleCLT.Companion.SplitV4.familyObservation : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters →
  {m : ℕ} → RectangleCLT.Companion.SplitV4.FamilySeed m → RectangleCLT.Vector (m * m) :=
fun P {m} z r =>
  let ju := finProdFinEquiv.symm r;
  P.scale * RectangleCLT.Companion.SplitV4.familySign (z.1 ju.1) +
    RectangleCLT.Companion.SplitV4.familyActivated P z.2 ju.2
def RectangleCLT.Companion.SplitV4.familyRawObservations : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters →
  {n m : ℕ} → Fin n → (Fin n → RectangleCLT.Companion.SplitV4.FamilySeed m) → RectangleCLT.Vector (m * m) :=
fun P {n m} i z => RectangleCLT.Companion.SplitV4.familyObservation P (z i)
def RectangleCLT.Companion.SplitV4.familyNormalizedObservations : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters →
  {n m : ℕ} → Fin n → (Fin n → RectangleCLT.Companion.SplitV4.FamilySeed m) → RectangleCLT.Vector (m * m) :=
fun P {n m} i z => (1 / √↑n) • RectangleCLT.Companion.SplitV4.familyRawObservations P i z
def RectangleCLT.Companion.SplitV4.familyCovariance : (m : ℕ) → ℝ → Matrix (Fin (m * m)) (Fin (m * m)) ℝ :=
fun m v r r' =>
  let ju := finProdFinEquiv.symm r;
  let ju' := finProdFinEquiv.symm r';
