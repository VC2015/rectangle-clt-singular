RectangleCLT.Companion.rectangleError_le_coarse_bandwidth.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] {p n : ℕ}
  {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsProbabilityMeasure μ] {ξ : Fin n → Ω → RectangleCLT.Vector p} {δ : ℝ}
  (hdata : RectangleCLT.BoundedIndependentHypotheses μ ξ δ) (hp : 1 ≤ p)
  (hunit : ∀ (j : Fin p), RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) j j = 1) (A : Matrix (Fin p) (Fin p) ℝ)
  (hA : A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.sumVector ξ)) (R : RectangleCLT.Rect p) (h : ℝ)
  (hband : 12 * δ ≤ h) :
  RectangleCLT.rectangleError μ (RectangleCLT.sumVector ξ) A R ≤
    RectangleCLT.Companion.coarseBandwidthConstant * √(RectangleCLT.dimensionLog p) *
      (RectangleCLT.gamma3 μ ξ / h ^ 2 + RectangleCLT.gamma4 μ ξ / h ^ 3 + h * RectangleCLT.dimensionLog p)
