def RectangleCLT.Companion.SkewedTwoPointLowerScale : Prop :=
∀ (B : ℕ → ℝ) (p : ℕ → ℕ),
  Filter.Tendsto p Filter.atTop Filter.atTop →
    (∀ (n : ℕ), 2 ≤ B n) →
      Filter.Tendsto (fun n => RectangleCLT.Companion.lowerSkewRate (B n) (p n) n) Filter.atTop (nhds 0) →
        (∀ (n : ℕ), 1 ≤ n → 1 ≤ p n → RectangleCLT.Companion.LowerConstructionProperties (B n) n (p n)) ∧
          RectangleCLT.Companion.skewLowerScaleConstant ≤
            Filter.liminf
              (fun n =>
                RectangleCLT.Companion.lowerConstructionDistance (B n) n (p n) /
                  RectangleCLT.Companion.lowerSkewRate (B n) (p n) n)
              Filter.atTop
