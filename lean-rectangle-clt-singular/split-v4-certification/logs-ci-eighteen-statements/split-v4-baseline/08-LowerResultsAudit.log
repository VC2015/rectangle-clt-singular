def RectangleCLT.Companion.rectangleDistance.{u_1} : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] →
    {p : ℕ} → MeasureTheory.Measure Ω → (Ω → RectangleCLT.Vector p) → Matrix (Fin p) (Fin p) ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] {p} μ W A => sSup (Set.range (RectangleCLT.rectangleError μ W A))
def RectangleCLT.Companion.lowerConstructionDistance : ℝ → ℕ → ℕ → ℝ :=
fun B n p =>
  RectangleCLT.Companion.rectangleDistance (RectangleCLT.Companion.lowerArrayLaw B n p)
    (RectangleCLT.sumVector RectangleCLT.Companion.lowerNormalizedRows) 1
def RectangleCLT.Companion.lowerSkewRate : ℝ → ℕ → ℕ → ℝ :=
fun B p n => B * Real.log ↑p ^ (3 / 2) / √↑n
def RectangleCLT.Companion.skewLowerScaleConstant : ℝ :=
√2 / (4 * Real.exp 1)
def RectangleCLT.Companion.uniformClassErrors.{u} : Bool → ℝ → ℝ → ℕ → ℕ → Set ℝ :=
fun zeroSkew c₀ B p n =>
  {e |
    e = 0 ∨
      ∃ Ω mΩ μ,
        MeasureTheory.IsProbabilityMeasure μ ∧
          ∃ ξ A R,
            RectangleCLT.BoundedIndependentHypotheses μ ξ (B / √↑n) ∧
              (∀ (j : Fin p), RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) j j = 1) ∧
                c₀ ≤ RectangleCLT.pairGap (RectangleCLT.covariance μ (RectangleCLT.sumVector ξ)) ∧
                  A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) ∧
                    (zeroSkew = true → RectangleCLT.Companion.AggregateThirdMomentsVanish μ ξ) ∧
                      e = RectangleCLT.rectangleError μ (RectangleCLT.sumVector ξ) A R}
def RectangleCLT.Companion.uniformWorstError.{u} : Bool → ℝ → ℝ → ℕ → ℕ → ℝ :=
fun zeroSkew c₀ B p n => sSup (RectangleCLT.Companion.uniformClassErrors zeroSkew c₀ B p n)
def RectangleCLT.Companion.fixedGapWorstError.{u} : ℝ → ℝ → ℕ → ℕ → ℝ :=
fun c₀ B p n => RectangleCLT.Companion.uniformWorstError false c₀ B p n
def RectangleCLT.Companion.zeroSkewFixedGapWorstError.{u} : ℝ → ℝ → ℕ → ℕ → ℝ :=
fun c₀ B p n => RectangleCLT.Companion.uniformWorstError true c₀ B p n
def RectangleCLT.Companion.UniformConsistencyTheorem.{u} : Prop :=
∀ (c₀ : ℝ),
  0 < c₀ →
    c₀ ≤ 1 →
      (∀ (B : ℕ → ℝ) (p : ℕ → ℕ),
          (∀ (n : ℕ), 2 ≤ B n) →
            (∀ (n : ℕ), 1 ≤ p n) →
              (Filter.Tendsto (fun n => RectangleCLT.Companion.fixedGapWorstError c₀ (B n) (p n) n) Filter.atTop
                  (nhds 0) ↔
                Filter.Tendsto (fun n => B n * RectangleCLT.dimensionLog (p n) ^ (3 / 2) / √↑n) Filter.atTop
                  (nhds 0))) ∧
        ∀ (B : ℝ) (p : ℕ → ℕ),
          1 ≤ B →
            (∀ (n : ℕ), 1 ≤ p n) →
              (Filter.Tendsto (fun n => RectangleCLT.Companion.zeroSkewFixedGapWorstError c₀ B (p n) n) Filter.atTop
                  (nhds 0) ↔
                Filter.Tendsto (fun n => Real.log ↑(p n) / √↑n) Filter.atTop (nhds 0))
