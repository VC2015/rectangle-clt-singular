    "Theorem 4": {
      "declaration": "RectangleCLT.Companion.skewedTwoPointLowerScale",
      "constant": "sqrt(2)/(4*exp(1))",
      "properties": [
        "arbitrary B_n >= 2",
        "p_n tends to infinity",
        "B_n*(log p_n)^(3/2)/sqrt n tends to zero",
        "actual iid independent-coordinate two-point construction",
        "identity covariance",
        "attained envelope",
        "full supremum rectangle distance lower limit"
      ]
    },
    "Theorem 5": {
      "declaration": "RectangleCLT.Companion.uniformConsistencyTheorem",
      "general": "For fixed c0 in (0,1], arbitrary B_n >= 2 and p_n >= 1, M_n tends to zero iff B_n*log(e*p_n)^(3/2)/sqrt n tends to zero.",
      "zero_skew": "For each fixed B >= 1 and arbitrary p_n >= 1, M_n^0 tends to zero iff log(p_n)/sqrt n tends to zero.",
      "uniformity": "The numerical supremum is formed over the full probability class before the limit; cancellation is the full signed aggregate mixed third tensor."
    }
  },
