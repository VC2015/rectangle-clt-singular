import RectangleCLTArxivV1.SupplementalHNormalChartIsometry
import RectangleCLTArxivV1.SupplementalHPositiveWedge

/-! Exact angular identification for an actual polygon edge in its
orthogonal tangent chart. The only set-theoretic premise is the geometric
facet equality; no angular measure or spherical balance is supplied. -/
namespace RectangleCLTArxivV1
open MeasureTheory Set Metric RectangleCLT RectangleCLT.Companion.SplitV4
open RectangleCLT.Companion.SignedSurface
open scoped InnerProductSpace
noncomputable section
local notation "E3" => EuclideanSpace ℝ (Fin 3)
local notation "E2" => EuclideanSpace ℝ (Fin 2)

/-- The actual inverse normal-section coordinates of an endpoint ray. -/
def sphericalPolygonFacetCoordinates (u : Vector 3) (v : E3) : E2 :=
  (WithLp.equiv 2 (Vector 2)).symm
    (normalSectionCoordinates (0 : Fin 3) u (WithLp.equiv 2 (Vector 3) v))

/-- Pullback of a cone to its actual orthogonal supporting-plane chart. -/
def sphericalPolygonFacetChart (C : Set E3) (u : Vector 3) : Set E2 :=
  (euclideanNormalSectionIsometry (0 : Fin 3) u) ⁻¹' C

theorem sphericalPolygonFacetCoordinates_map (u : Vector 3) (hu : vectorNormSq u=1)
    (v : E3) (hv : faceDot u (WithLp.equiv 2 (Vector 3) v)=0) :
    euclideanNormalSectionIsometry (0 : Fin 3) u
      (sphericalPolygonFacetCoordinates u v)=v := by
  change (WithLp.equiv 2 (Vector 3)).symm
    (normalSectionChart (0 : Fin 3) u 0
      (normalSectionCoordinates (0 : Fin 3) u (WithLp.equiv 2 (Vector 3) v)))=v
  rw [normalSectionChart_coordinates _ _ hu _ hv]
  exact Equiv.symm_apply_apply _ _

theorem sphericalPolygonFacetCoordinates_norm (u : Vector 3) (hu : vectorNormSq u=1)
    (v : E3) (hv : faceDot u (WithLp.equiv 2 (Vector 3) v)=0) :
    ‖sphericalPolygonFacetCoordinates u v‖=‖v‖ := by
  rw [← (euclideanNormalSectionIsometry (0 : Fin 3) u).norm_map,
    sphericalPolygonFacetCoordinates_map u hu v hv]

theorem sphericalPolygonFacetCoordinates_inner (u : Vector 3) (hu : vectorNormSq u=1)
    (v w : E3) (hv : faceDot u (WithLp.equiv 2 (Vector 3) v)=0)
    (hw : faceDot u (WithLp.equiv 2 (Vector 3) w)=0) :
    ⟪sphericalPolygonFacetCoordinates u v,sphericalPolygonFacetCoordinates u w⟫_ℝ=
      ⟪v,w⟫_ℝ := by
  rw [← (euclideanNormalSectionIsometry (0 : Fin 3) u).inner_map_map,
    sphericalPolygonFacetCoordinates_map u hu v hv,
    sphericalPolygonFacetCoordinates_map u hu w hw]

theorem sphericalPolygonFacetChart_on_plane (u : Vector 3) (hu : vectorNormSq u=1)
    (y : E2) :
    faceDot u (WithLp.equiv 2 (Vector 3)
      (euclideanNormalSectionIsometry (0 : Fin 3) u y))=0 := by
  exact normalSectionChart_on_hyperplane (0 : Fin 3) u hu 0
    (WithLp.equiv 2 (Vector 2) y)

/-- A genuine supporting face generated by two rays pulls back to the
genuine positive planar wedge between their inverse-chart coordinates. -/
theorem sphericalPolygonFacetChart_eq_positivePlanarWedge
    (C : Set E3) (u : Vector 3) (hu : vectorNormSq u=1) (v w : E3)
    (hv : faceDot u (WithLp.equiv 2 (Vector 3) v)=0)
    (hw : faceDot u (WithLp.equiv 2 (Vector 3) w)=0)
    (hface : {x : E3 | x∈C ∧ faceDot u (WithLp.equiv 2 (Vector 3) x)=0}=
      positivePlanarWedge v w) :
    sphericalPolygonFacetChart C u=
      positivePlanarWedge (sphericalPolygonFacetCoordinates u v)
        (sphericalPolygonFacetCoordinates u w) := by
  let A := euclideanNormalSectionIsometry (0 : Fin 3) u
  have hvmap := sphericalPolygonFacetCoordinates_map u hu v hv
  have hwmap := sphericalPolygonFacetCoordinates_map u hu w hw
  ext y
  change A y∈C ↔ y∈positivePlanarWedge _ _
  constructor
  · intro hy
    have hmem : A y∈{x : E3 | x∈C ∧ faceDot u (WithLp.equiv 2 (Vector 3) x)=0} :=
      ⟨hy,sphericalPolygonFacetChart_on_plane u hu y⟩
    rw [hface] at hmem
    rcases hmem with ⟨a,b,ha,hb,he⟩
    refine ⟨a,b,ha,hb,?_⟩
    apply A.injective
    rw [map_add,map_smul,map_smul,hvmap,hwmap]
    exact he
  · rintro ⟨a,b,ha,hb,rfl⟩
    have hmem : A (a • sphericalPolygonFacetCoordinates u v+
        b • sphericalPolygonFacetCoordinates u w)∈positivePlanarWedge v w := by
      rw [map_add,map_smul,map_smul,hvmap,hwmap]
      exact ⟨a,b,ha,hb,rfl⟩
    rw [←hface] at hmem
    exact hmem.1

theorem sphericalPolygonFacetCoordinates_nonparallel (u : Vector 3)
    (hu : vectorNormSq u=1) (v w : E3)
    (hv : faceDot u (WithLp.equiv 2 (Vector 3) v)=0)
    (hw : faceDot u (WithLp.equiv 2 (Vector 3) w)=0)
    (hp : v+w≠0) (hm : v-w≠0) :
    sphericalPolygonFacetCoordinates u v+sphericalPolygonFacetCoordinates u w≠0 ∧
      sphericalPolygonFacetCoordinates u v-sphericalPolygonFacetCoordinates u w≠0 := by
  let A := euclideanNormalSectionIsometry (0 : Fin 3) u
  have hvmap := sphericalPolygonFacetCoordinates_map u hu v hv
  have hwmap := sphericalPolygonFacetCoordinates_map u hu w hw
  constructor
  · intro hz
    apply hp
    have hh := congrArg A hz
    change A (sphericalPolygonFacetCoordinates u v)=v at hvmap
    change A (sphericalPolygonFacetCoordinates u w)=w at hwmap
    simpa only [map_add,map_zero,hvmap,hwmap] using hh
  · intro hz
    apply hm
    have hh := congrArg A hz
    change A (sphericalPolygonFacetCoordinates u v)=v at hvmap
    change A (sphericalPolygonFacetCoordinates u w)=w at hwmap
    simpa only [map_sub,map_zero,hvmap,hwmap] using hh

/-- The actual polar angular measure of a polygon facet chart is the
ordinary angle between its actual unit endpoint rays. -/
theorem sphericalPolygonFacetChart_angular_area
    (C : Set E3) (u : Vector 3) (hu : vectorNormSq u=1) (v w : E3)
    (hvunit : ‖v‖=1) (hwunit : ‖w‖=1)
    (hv : faceDot u (WithLp.equiv 2 (Vector 3) v)=0)
    (hw : faceDot u (WithLp.equiv 2 (Vector 3) w)=0)
    (hp : v+w≠0) (hm : v-w≠0)
    (hface : {x : E3 | x∈C ∧ faceDot u (WithLp.equiv 2 (Vector 3) x)=0}=
      positivePlanarWedge v w) :
    (volume : Measure E2).toSphere.real
      (supplementalHSphericalSection (sphericalPolygonFacetChart C u))=
        Real.arccos ⟪v,w⟫_ℝ := by
  have hpair := sphericalPolygonFacetCoordinates_nonparallel u hu v w hv hw hp hm
  rw [sphericalPolygonFacetChart_eq_positivePlanarWedge C u hu v w hv hw hface,
    positivePlanarWedge_angular_area (by simp) _ _
      ((sphericalPolygonFacetCoordinates_norm u hu v hv).trans hvunit)
      ((sphericalPolygonFacetCoordinates_norm u hu w hw).trans hwunit) hpair.1 hpair.2,
    sphericalPolygonFacetCoordinates_inner u hu v w hv hw]

end
end RectangleCLTArxivV1
