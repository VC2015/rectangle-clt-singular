import RectangleCLTArxivV1.SupplementalHTripleTransportModel

/-! The actual cone generated by the three original selected normals is
exactly the outward normal cone used by the Gaussian tube transport. -/
namespace RectangleCLTArxivV1
open MeasureTheory ProbabilityTheory Set RectangleCLT RectangleCLT.Companion.SplitV4
open RectangleCLT.Companion.SignedSurface
open scoped BigOperators InnerProductSpace
noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 1000000

def tripleIncidenceTransportTuple {m r : ℕ} (u : Fin m → Vector r)
    (F : Fin 3 → Fin m) (hi : LinearIndependent ℝ (fun i => u (F i))) : TripleFaceTuple m :=
  ⟨F,fun _ _ h => hi.injective (congrArg u h)⟩

theorem tripleIncidenceTransport_active_span {m r : ℕ} (u : Fin m → Vector r)
    (F : Fin 3 → Fin m) (hi : LinearIndependent ℝ (fun i => u (F i)))
    (hu : ∀ i, vectorNormSq (u (F i))=1) (k : Fin m)
    (hk : k∈tripleFaceActive (tripleIncidenceTransportTuple u F hi)) :
    projectionEuclideanVector (u k)∈Submodule.span ℝ
      (range (tripleTransportFrame (tripleIncidenceTransportIsometry u F hi hu))) := by
  obtain ⟨i,_,rfl⟩ := Finset.mem_image.mp hk
  rw [tripleIncidenceTransportFrame_span]
  exact Submodule.subset_span ⟨i,rfl⟩

theorem tripleIncidenceTransport_active_levels {m r : ℕ} (u : Fin m → Vector r)
    (b : Vector m) (F : Fin 3 → Fin m) (hi : LinearIndependent ℝ (fun i => u (F i)))
    (hu : ∀ i, vectorNormSq (u (F i))=1) (k : Fin m)
    (hk : k∈tripleFaceActive (tripleIncidenceTransportTuple u F hi)) :
    ⟪projectionEuclideanVector (u k),
      tripleIncidenceTransportIsometry u F hi hu (tripleIncidenceTransportPoint u b F)⟫_ℝ=b k := by
  obtain ⟨i,_,rfl⟩ := Finset.mem_image.mp hk
  exact tripleIncidenceTransport_supporting_levels u b F hi hu i

theorem tripleIncidenceTransport_cone_eq {m r : ℕ} (u : Fin m → Vector r)
    (F : Fin 3 → Fin m) (hi : LinearIndependent ℝ (fun i => u (F i)))
    (hu : ∀ i, vectorNormSq (u (F i))=1) :
    trihedralGeneratedCone (tripleIncidenceTransportBasis u F hi hu)=
      tripleOutwardNormalCone u (tripleFaceActive (tripleIncidenceTransportTuple u F hi))
        (tripleIncidenceTransportIsometry u F hi hu) := by
  classical
  let L := tripleIncidenceTransportIsometry u F hi hu
  let e := tripleIncidenceTransportBasis u F hi hu
  have hF : Function.Injective F := (tripleIncidenceTransportTuple u F hi).2
  have hs (c : Fin m → ℝ) :
      coneDisplacement (fun k => projectionEuclideanVector (u k))
        (tripleFaceActive (tripleIncidenceTransportTuple u F hi)) c=
      ∑ i, c (F i) • tripleIncidenceOriginalNormals u F i := by
    unfold coneDisplacement tripleFaceActive tripleIncidenceTransportTuple
    rw [Finset.sum_image]
    · rfl
    · exact fun _ _ _ _ h => hF h
  ext y
  constructor
  · rintro ⟨a,ha,he⟩
    let c : Fin m → ℝ := Function.extend F a (fun _ => 0)
    have hc (i : Fin 3) : c (F i)=a i := hF.extend_apply _ _ i
    refine ⟨c,?_,?_⟩
    · intro k hk
      obtain ⟨i,_,rfl⟩ := Finset.mem_image.mp hk
      change 0≤c (F i)
      rw [hc]
      exact ha i
    · rw [hs,he,map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [map_smul,tripleIncidenceTransportIsometry_basis,hc]
  · rintro ⟨c,hc,he⟩
    refine ⟨fun i => c (F i),fun i => hc _ (Finset.mem_image.mpr ⟨i,Finset.mem_univ _,rfl⟩),?_⟩
    apply L.injective
    rw [he,hs,map_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [map_smul,tripleIncidenceTransportIsometry_basis]

theorem tripleIncidenceTransport_cone_measurableSet {m r : ℕ} (u : Fin m → Vector r)
    (F : Fin 3 → Fin m) (hi : LinearIndependent ℝ (fun i => u (F i)))
    (hu : ∀ i, vectorNormSq (u (F i))=1) :
    MeasurableSet (trihedralGeneratedCone (tripleIncidenceTransportBasis u F hi hu)) := by
  rw [trihedralGeneratedCone_eq_halfspaces]
  simp only [setOf_forall]
  exact MeasurableSet.iInter (fun i => (isClosed_le (continuous_const.inner continuous_id) continuous_const).measurableSet)

theorem tripleIncidenceTransport_cone_smul_iff {m r : ℕ} (u : Fin m → Vector r)
    (F : Fin 3 → Fin m) (hi : LinearIndependent ℝ (fun i => u (F i)))
    (hu : ∀ i, vectorNormSq (u (F i))=1) (t : ℝ) (ht : 0<t)
    (y : EuclideanSpace ℝ (Fin 3)) :
    t • y∈trihedralGeneratedCone (tripleIncidenceTransportBasis u F hi hu) ↔
      y∈trihedralGeneratedCone (tripleIncidenceTransportBasis u F hi hu) := by
  rw [tripleIncidenceTransport_cone_eq]
  exact tripleOutwardNormalCone_smul_iff _ _ _ t ht y

end
end RectangleCLTArxivV1
