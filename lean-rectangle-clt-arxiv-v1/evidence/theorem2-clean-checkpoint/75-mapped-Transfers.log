def RectangleCLTArxivV1.PolynomialEnvelopeBound.{u} : ℝ → ℝ → Prop :=
fun q C =>
  ∀ (p n : ℕ),
    1 ≤ p →
      1 ≤ n →
        ∀ (B : ℝ),
          1 ≤ B →
            ∀ {Ω : Type u} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
              [inst_1 : MeasureTheory.IsProbabilityMeasure μ] (X : Fin n → Ω → RectangleCLT.Vector p),
              RectangleCLTArxivV1.PolynomialEnvelopeHypotheses μ X q B →
                ∀ (A : Matrix (Fin p) (Fin p) ℝ),
                  A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.Companion.normalizedObservationSum X) →
                    RectangleCLT.Companion.rectangleDistance μ (RectangleCLT.Companion.normalizedObservationSum X) A ≤
                      C *
                        min 1
                          (RectangleCLTArxivV1.polynomialEnvelopeWidthRate n p B q
                            (RectangleCLTArxivV1.gaussianMaximumMean A))
def RectangleCLTArxivV1.PolynomialFourthBound.{u} : ℝ → ℝ → Prop :=
fun q C =>
  ∀ (p n : ℕ),
    1 ≤ p →
      1 ≤ n →
        ∀ (B : ℝ),
          1 ≤ B →
