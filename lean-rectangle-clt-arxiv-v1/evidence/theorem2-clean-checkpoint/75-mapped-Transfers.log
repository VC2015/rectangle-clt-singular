              [inst_1 : MeasureTheory.IsProbabilityMeasure μ] (X : Fin n → Ω → RectangleCLT.Vector p),
              RectangleCLTArxivV1.PolynomialFourthHypotheses μ X q B →
                ∀ (A : Matrix (Fin p) (Fin p) ℝ),
                  A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.Companion.normalizedObservationSum X) →
                    RectangleCLT.Companion.rectangleDistance μ (RectangleCLT.Companion.normalizedObservationSum X) A ≤
                      C *
                        min 1
                          (RectangleCLTArxivV1.polynomialFourthWidthRate n p B q
                            (RectangleCLTArxivV1.gaussianMaximumMean A))
def RectangleCLTArxivV1.PolynomialMomentTheorem.{u} : ℝ → Prop :=
fun q =>
  2 < q → ∃ C, 0 < C ∧ RectangleCLTArxivV1.PolynomialEnvelopeBound q C ∧ RectangleCLTArxivV1.PolynomialFourthBound q C
def RectangleCLTArxivV1.polynomialEnvelopeWidthRate : ℕ → ℕ → ℝ → ℝ → ℝ → ℝ :=
fun n p B q g =>
  B * g * RectangleCLT.dimensionLog p ^ (1 - 1 / q) * RectangleCLT.dimensionLog n ^ (1 / 2 - 1 / q) /
    ↑n ^ (1 / 2 - 1 / q)
def RectangleCLTArxivV1.polynomialFourthWidthRate : ℕ → ℕ → ℝ → ℝ → ℝ → ℝ :=
fun n p B q g =>
  g *
    (B ^ (1 / 2) * RectangleCLT.dimensionLog p ^ (3 / 4) / ↑n ^ (1 / 4) +
      B * RectangleCLT.dimensionLog p ^ (1 - 1 / q) /
        (↑n ^ (1 / 2 - 1 / q) *
          Real.log (Real.exp 1 + B * (↑n / RectangleCLT.dimensionLog p) ^ (2 / q - 1 / 2)) ^ (1 - 1 / q)))
