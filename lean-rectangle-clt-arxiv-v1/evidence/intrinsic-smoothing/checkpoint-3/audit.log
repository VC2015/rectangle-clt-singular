RectangleCLTArxivV1.gaussian_mean_relative_to_single_face {r : Nat} (u : RectangleCLT.Vector r)
  (hu : Eq.{1} (RectangleCLT.vectorNormSq u) 1) (β : Real → Real) (hβ : Measurable.{0, 0} β)
  (hβb : ∀ (a : Real), And (LE.le.{0} 0 (β a)) (LE.le.{0} (β a) 1)) (w : RectangleCLT.Vector r → Real)
  (hw : Measurable.{0, 0} w)
  (hwb : ∀ (z : RectangleCLT.Vector r), And (LE.le.{0} 0 (w z)) (LE.le.{0} (w z) (β (RectangleCLT.faceDot u z))))
  (_hpb : LT.lt.{0} 0 (∫ (z : RectangleCLT.Vector r), β (RectangleCLT.faceDot u z) ∂RectangleCLT.standardGaussian r))
  (hpw : LT.lt.{0} 0 (RectangleCLT.Companion.weightMass.{0} (RectangleCLT.standardGaussian r) w)) :
  LE.le.{0}
    (HMul.hMul.{0, 0, 0} (RectangleCLT.Companion.weightMass.{0} (RectangleCLT.standardGaussian r) w)
      (RectangleCLT.vectorNormSq (RectangleCLT.Companion.weightMean.{0} (RectangleCLT.standardGaussian r) id.{1} w)))
    (HAdd.hAdd.{0, 0, 0}
      (∫ (z : RectangleCLT.Vector r),
        HMul.hMul.{0, 0, 0} (w z) (HPow.hPow.{0, 0, 0} (RectangleCLT.faceDot u z) 2) ∂RectangleCLT.standardGaussian r)
      (HMul.hMul.{0, 0, 0}
        (HMul.hMul.{0, 0, 0} 2 (RectangleCLT.Companion.weightMass.{0} (RectangleCLT.standardGaussian r) w))
        (Real.log
          (HDiv.hDiv.{0, 0, 0}
