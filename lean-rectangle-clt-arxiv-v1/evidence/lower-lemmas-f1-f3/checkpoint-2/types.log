structure RectangleCLTArxivV1.LowerRectangularFamilyProperties
  (P : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters) (n r m : ℕ) : Prop
number of parameters: 4
fields:
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.independent : ProbabilityTheory.iIndepFun
      (RectangleCLTArxivV1.lowerFamilyRawObservations P) (RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m)
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.iid : ∀ (i j : Fin n),
      ProbabilityTheory.IdentDistrib (RectangleCLTArxivV1.lowerFamilyRawObservations P i)
        (RectangleCLTArxivV1.lowerFamilyRawObservations P j) (RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m)
        (RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m)
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.symmetric : ∀ (i : Fin n),
      ProbabilityTheory.IdentDistrib (RectangleCLTArxivV1.lowerFamilyRawObservations P i)
