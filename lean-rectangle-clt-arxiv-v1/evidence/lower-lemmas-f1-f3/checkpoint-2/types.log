        (RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m) (RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m)
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.centered : ∀ (i : Fin n) (j : Fin (r * m)),
      ∫ (z : Fin n → RectangleCLTArxivV1.LowerFamilySeed r m),
          RectangleCLTArxivV1.lowerFamilyRawObservations P i z j ∂RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m =
        0
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.second : ∀ (i : Fin n) (j k : Fin (r * m)),
      ∫ (z : Fin n → RectangleCLTArxivV1.LowerFamilySeed r m),
          RectangleCLTArxivV1.lowerFamilyRawObservations P i z j *
            RectangleCLTArxivV1.lowerFamilyRawObservations P i z k ∂RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m =
        RectangleCLTArxivV1.lowerFamilyCovariance r m P.variance j k
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.unit_second : ∀ (i : Fin n) (j : Fin (r * m)),
      ∫ (z : Fin n → RectangleCLTArxivV1.LowerFamilySeed r m),
          RectangleCLTArxivV1.lowerFamilyRawObservations P i z j ^ 2 ∂RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m =
        1
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.covariance : RectangleCLT.covariance
        (RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m)
        (RectangleCLT.sumVector (RectangleCLTArxivV1.lowerFamilyNormalizedObservations P)) =
      RectangleCLTArxivV1.lowerFamilyCovariance r m P.variance
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.rank : (RectangleCLTArxivV1.lowerFamilyCovariance r m
          P.variance).rank =
      r + m - 1
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.gap : RectangleCLT.pairGap
        (RectangleCLTArxivV1.lowerFamilyCovariance r m P.variance) =
      P.variance
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.fourth : ∀ (i : Fin n) (j : Fin (r * m)),
      ∫ (z : Fin n → RectangleCLTArxivV1.LowerFamilySeed r m),
          RectangleCLTArxivV1.lowerFamilyRawObservations P i z j ^ 4 ∂RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m =
        1 + 4 * P.variance - 5 * P.variance ^ 2 + P.theta * P.pi * P.amplitude ^ 4
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.envelope : ∀ (i : Fin n)
      (z : Fin n → RectangleCLTArxivV1.LowerFamilySeed r m),
      ‖RectangleCLTArxivV1.lowerFamilyRawObservations P i z‖ ≤
        P.scale + P.amplitude * RectangleCLT.Companion.SplitV4.familyIndicator (z i).2.2.1
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.envelope_moment : ∀ (q : ℝ),
      1 ≤ q →
        ∀ (i : Fin n),
          (∫ (z : Fin n → RectangleCLTArxivV1.LowerFamilySeed r m),
                ‖RectangleCLTArxivV1.lowerFamilyRawObservations P i z‖ ^
                  q ∂RectangleCLTArxivV1.lowerFamilyArrayLaw P n r m) ^
              (1 / q) ≤
            P.scale + P.amplitude * P.theta ^ (1 / q)
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.gaussian : ∃ A,
      A * A.transpose = RectangleCLTArxivV1.lowerFamilyCovariance r m P.variance ∧
        RectangleCLTArxivV1.lowerGridGaussianLaw r m P.scale √P.variance = RectangleCLT.gaussianLaw A ∧
          P.scale * RectangleCLTArxivV1.independentAbsGaussianMean r ≤ RectangleCLTArxivV1.gaussianMaximumMean A ∧
            RectangleCLTArxivV1.gaussianMaximumMean A ≤
              P.scale * RectangleCLTArxivV1.independentAbsGaussianMean r +
                √P.variance * RectangleCLTArxivV1.independentAbsGaussianMean m
constructor:
  RectangleCLTArxivV1.LowerRectangularFamilyProperties.mk {P : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters}
