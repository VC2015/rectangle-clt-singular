@RectangleCLTArxivV1.lowerAdditiveGridFactor_mulVec : ∀ {r m : ℕ} (a b : ℝ) (x : Fin r ⊕ Fin m → ℝ)
  (ju : Fin r × Fin m),
  (RectangleCLTArxivV1.lowerAdditiveGridFactor r m a b).mulVec x ju = a * x (Sum.inl ju.1) + b * x (Sum.inr ju.2)
@RectangleCLTArxivV1.lowerAdditiveGridFactor_gram : ∀ {r m : ℕ} (a b : ℝ),
  RectangleCLTArxivV1.lowerAdditiveGridFactor r m a b *
      (RectangleCLTArxivV1.lowerAdditiveGridFactor r m a b).transpose =
    fun ju ju' => (a ^ 2 * if ju.1 = ju'.1 then 1 else 0) + b ^ 2 * if ju.2 = ju'.2 then 1 else 0
@RectangleCLTArxivV1.lowerAdditiveGridFactor_ker : ∀ {r m : ℕ},
  1 ≤ r →
    1 ≤ m →
      ∀ {a b : ℝ},
        a ≠ 0 →
          b ≠ 0 →
            LinearMap.ker (RectangleCLTArxivV1.lowerAdditiveGridFactor r m a b).mulVecLin =
              Submodule.span ℝ {RectangleCLTArxivV1.lowerAdditiveGridKernelVector r m a b}
@RectangleCLTArxivV1.lowerAdditiveGridFactor_rank : ∀ {r m : ℕ},
  1 ≤ r → 1 ≤ m → ∀ {a b : ℝ}, a ≠ 0 → b ≠ 0 → (RectangleCLTArxivV1.lowerAdditiveGridFactor r m a b).rank = r + m - 1
@RectangleCLTArxivV1.lowerFamilyPairCovariance_gram : ∀ {r m : ℕ} {v : ℝ},
  0 < v →
