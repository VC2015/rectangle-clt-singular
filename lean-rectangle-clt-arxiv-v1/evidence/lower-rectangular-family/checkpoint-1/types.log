      RectangleCLTArxivV1.lowerFamilyPairCovariance r m v =
        RectangleCLTArxivV1.lowerAdditiveGridFactor r m √(1 - v) √v *
          (RectangleCLTArxivV1.lowerAdditiveGridFactor r m √(1 - v) √v).transpose
@RectangleCLTArxivV1.lowerFamilyPairCovariance_rank : ∀ {r m : ℕ},
  1 ≤ r → 1 ≤ m → ∀ {v : ℝ}, 0 < v → v < 1 → (RectangleCLTArxivV1.lowerFamilyPairCovariance r m v).rank = r + m - 1
RectangleCLTArxivV1.lowerFamilyCovariance_eq_pair_submatrix : ∀ (r m : ℕ) (v : ℝ),
  RectangleCLTArxivV1.lowerFamilyCovariance r m v =
    (RectangleCLTArxivV1.lowerFamilyPairCovariance r m v).submatrix ⇑finProdFinEquiv.symm ⇑finProdFinEquiv.symm
