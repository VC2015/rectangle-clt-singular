  1 ≤ r → 2 ≤ m → ∀ (v : ℝ), ∃ j k, j ≠ k ∧ RectangleCLTArxivV1.lowerFamilyCovariance r m v j k = 1 - v
@RectangleCLTArxivV1.lowerFamilyCovariance_maxOffDiagonal : ∀ {r m : ℕ},
  1 ≤ r →
    2 ≤ m →
      ∀ {v : ℝ},
        0 < v → v < 1 / 2 → RectangleCLT.maxOffDiagonal (RectangleCLTArxivV1.lowerFamilyCovariance r m v) = 1 - v
