@RectangleCLT.Companion.SplitV4.Printed.gaussianMollifiedRamp_deriv_tendsto : ∀ {ι : Type u_1} {l : Filter ι} {s : ℝ},
  0 < s →
    ∀ (φ : ι → ContDiffBump 0),
      Filter.Tendsto (fun i => (φ i).rOut) l (nhds 0) →
        ∀ {x : ℝ},
          x ≠ -s →
            x ≠ s →
              Filter.Tendsto (fun i => deriv (RectangleCLT.Companion.SplitV4.Printed.gaussianMollifiedRamp s (φ i)) x) l
                (nhds ((Set.Ioo (-s) s).indicator (fun x => 1 / (2 * s)) x))
