@RectangleCLTArxivV1.lemma_C1_gaussian_model : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [inst_1 : MeasureTheory.IsProbabilityMeasure μ] {r m : ℕ} [inst_2 : NeZero m] (V R : Ω → RectangleCLT.Vector r),
  Measurable V →
    Measurable R →
      ProbabilityTheory.IndepFun V R μ →
        ∀ (ν : Matrix (Fin m) (Fin r) ℝ) (A : Matrix (Fin r) (Fin r) ℝ),
          MeasureTheory.Measure.map V μ = RectangleCLT.gaussianLaw A →
            ∀ (p : ℕ),
              1 ≤ p →
                m ≤ 2 * p →
                  (∀ (α : Fin m), ∃ β, ν β = -ν α) →
                    ∀ (a : RectangleCLT.Vector m) {v s : ℝ},
                      0 < v →
                        0 < s →
                          (∀ (α : Fin m), ν α ⬝ᵥ (A * A.transpose).mulVec (ν α) = v) →
                            μ.real {ω | V ω + R ω ∈ RectangleCLTArxivV1.faceLayer ν a s} ≤
                                min 1 (2 * s / v * ∫ (ω : Ω), RectangleCLTArxivV1.faceNorm ν (V ω) ∂μ) ∧
                              min 1 (2 * s / v * ∫ (ω : Ω), RectangleCLTArxivV1.faceNorm ν (V ω) ∂μ) ≤
                                4 * min 1 (s * √(RectangleCLT.dimensionLog p / v))
