@RectangleCLT.Companion.SplitV4.smoothGaussianFaceMaximum_stein : ∀ {m r : ℕ} [inst : NeZero m]
  (w : Fin m → RectangleCLT.Vector r) (a : Fin m → ℝ) (β : ℝ),
