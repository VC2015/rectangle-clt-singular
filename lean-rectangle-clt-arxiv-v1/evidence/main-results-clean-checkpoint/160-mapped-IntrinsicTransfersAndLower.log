@RectangleCLTArxivV1.bounded_width_example_one_eighth_from_main_regime : ∀ {m : ℕ → ℕ} [inst : ∀ (n : ℕ), NeZero (m n)],
  (∀ (n : ℕ), 2 ≤ m n) →
    Filter.Tendsto m Filter.atTop Filter.atTop →
      Filter.Tendsto
          (fun n => 2 * RectangleCLTArxivV1.independentAbsGaussianMean 1 * RectangleCLT.dimensionLog (m n) / √↑n)
          Filter.atTop (nhds 0) →
        Filter.Tendsto
            (fun n =>
              RectangleCLTArxivV1.gaussianMaximumMean
                (RectangleCLTArxivV1.lowerFamilyGaussianFactor (RectangleCLTArxivV1.lowerBoundedOneParameters m n) 1
                  (m n)))
            Filter.atTop (nhds √(2 / Real.pi)) ∧
          (∀ᶠ (n : ℕ) in Filter.atTop,
              RectangleCLTArxivV1.LowerRectangularFamilyProperties (RectangleCLTArxivV1.lowerBoundedOneParameters m n) n
                  1 (m n) ∧
                ∀ (i : Fin n) (z : Fin n → RectangleCLTArxivV1.LowerFamilySeed 1 (m n)),
