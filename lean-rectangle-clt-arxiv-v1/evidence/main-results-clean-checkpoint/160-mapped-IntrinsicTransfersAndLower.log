            ↑(1 / 8) ≤
              Filter.liminf
                (fun n =>
                  ↑(RectangleCLTArxivV1.lowerFamilyComparisonDistance
                        (RectangleCLTArxivV1.lowerBoundedOneParameters m n) n 1 (m n) /
                      RectangleCLTArxivV1.lowerBoundedOneTarget m n))
                Filter.atTop
@RectangleCLTArxivV1.cap_integrated_remainder_min_bound : ∀ {ε A S B C L : ℝ} {R : ℝ → ℝ},
  0 < ε →
    ε ≤ 1 / 4 →
      0 < A →
        0 < S →
          0 < B →
            0 ≤ C →
              1 ≤ L →
                max (Real.log (S / (A * √ε))) 0 ≤ 4 * L →
                  max (Real.log (B / A)) 0 ≤ 6 * L →
                    IntervalIntegrable R MeasureTheory.volume ε (1 + ε) →
                      (∀ v ∈ Set.Ioo ε (1 + ε), |R v| ≤ C * (min (A / v) (S / (v * √v)) + min (A / v) (B / √v))) →
                        (∀ v ∈ Set.Ioo ε (1 + ε), |R v| ≤ C * A / v) →
                          ∫ (v : ℝ) in ε..1 + ε, |R v| ≤ 38 * C * A * min (1 + Real.log (1 / ε)) L
@RectangleCLTArxivV1.dimensionCap_rate_of_small_bandwidth_estimate : ∀ {A C κ δ L error : ℝ},
  1 ≤ A →
    0 ≤ C →
      1 ≤ κ →
        0 < δ →
          1 ≤ L →
            error ≤ 1 →
              (L * RectangleCLTArxivV1.dimensionCapBandwidth A δ L ^ 2 < 1 / 4 →
                  error ≤
                    C * κ * L *
                      (RectangleCLTArxivV1.dimensionCapBandwidth A δ L + δ +
                        δ ^ 2 / RectangleCLTArxivV1.dimensionCapBandwidth A δ L *
                          min (1 + Real.log (1 / (L * RectangleCLTArxivV1.dimensionCapBandwidth A δ L ^ 2))) L)) →
                error ≤
                  RectangleCLTArxivV1.intrinsicOptimizationConstant A C *
                    min 1 (RectangleCLTArxivV1.dimensionCapRate κ δ L)
