@RectangleCLTArxivV1.lemma_H2_gaussian_matrix : ∀ {r : ℕ} (w : RectangleCLT.Vector r → ℝ),
  Measurable w →
    (∀ (g : RectangleCLT.Vector r), 0 ≤ w g) →
      MeasureTheory.Integrable w (RectangleCLT.standardGaussian r) →
        MeasureTheory.Integrable (fun g => RectangleCLT.vectorNormSq g * w g) (RectangleCLT.standardGaussian r) →
          0 < RectangleCLT.Companion.weightMass (RectangleCLT.standardGaussian r) w →
            RectangleCLT.Companion.SplitV4.Printed.NonnegativeLogConcave w →
              (1 - RectangleCLT.Companion.weightCovariance (RectangleCLT.standardGaussian r) id w).PosSemidef ∧
                RectangleCLT.Companion.SplitV4.symmetricNuclearNorm
                    (RectangleCLT.Companion.weightedScore (RectangleCLT.standardGaussian r) id w) ≤
                  2 * RectangleCLT.Companion.weightMass (RectangleCLT.standardGaussian r) w *
                      RectangleCLT.vectorNormSq
                        (RectangleCLT.Companion.weightMean (RectangleCLT.standardGaussian r) id w) -
                    ∫ (g : RectangleCLT.Vector r),
                      (RectangleCLT.vectorNormSq g - ↑r) * w g ∂RectangleCLT.standardGaussian r
@RectangleCLTArxivV1.lemma_H2_projected_reference : ∀ {r : ℕ} (P : Matrix (Fin r) (Fin r) ℝ),
  P.transpose = P →
    P * P = P →
      ∀ (β : RectangleCLT.Vector r → ℝ),
        Measurable β →
          (∀ (x : RectangleCLT.Vector r), 0 ≤ β x) →
            MeasureTheory.Integrable (fun g => β (P.mulVec g)) (RectangleCLT.standardGaussian r) →
              ∀ (w : RectangleCLT.Vector r → ℝ),
                Measurable w →
                  (∀ (g : RectangleCLT.Vector r), 0 ≤ w g ∧ w g ≤ β (P.mulVec g)) →
                    MeasureTheory.Integrable w (RectangleCLT.standardGaussian r) →
                      MeasureTheory.Integrable (fun g => RectangleCLT.vectorNormSq g * w g)
                          (RectangleCLT.standardGaussian r) →
                        0 < RectangleCLT.Companion.weightMass (RectangleCLT.standardGaussian r) w →
                          RectangleCLT.Companion.weightMass (RectangleCLT.standardGaussian r) w *
                              RectangleCLT.vectorNormSq
                                (RectangleCLT.Companion.weightMean (RectangleCLT.standardGaussian r) id w) ≤
                            ∫ (g : RectangleCLT.Vector r),
                                w g * RectangleCLT.vectorNormSq (P.mulVec g) ∂RectangleCLT.standardGaussian r +
                              2 * RectangleCLT.Companion.weightMass (RectangleCLT.standardGaussian r) w *
                                Real.log
                                  ((∫ (g : RectangleCLT.Vector r), β (P.mulVec g) ∂RectangleCLT.standardGaussian r) /
                                    RectangleCLT.Companion.weightMass (RectangleCLT.standardGaussian r) w)
@RectangleCLTArxivV1.lemma_B1_gaussian_seed_interpolation : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {p n : ℕ}
  (μ : MeasureTheory.Measure Ω) [inst_1 : MeasureTheory.IsProbabilityMeasure μ] (ξ : Fin n → Ω → RectangleCLT.Vector p)
  {δ : ℝ},
  RectangleCLT.BoundedIndependentHypotheses μ ξ δ →
    ∀ {F : RectangleCLT.Vector p → ℝ},
      ContDiff ℝ 4 F →
        ∀ {C : ℝ},
          0 ≤ C →
            (∀ (k : ℕ), 1 ≤ k → k ≤ 4 → ∀ (x : RectangleCLT.Vector p), ‖iteratedFDeriv ℝ k F x‖ ≤ C) →
              ∀ (A : Matrix (Fin p) (Fin p) ℝ),
                A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) →
                  ∀ (γ γ' : ℝ → ℝ) {ε : ℝ},
                    0 ≤ ε →
                      (∀ r ∈ Set.Ioo 0 1, HasDerivAt γ (γ' r) r) →
                        (∀ r ∈ Set.Ioo 0 1, 0 < γ r) →
                          (∀ r ∈ Set.Ioo 0 1, RectangleCLT.Companion.SplitV4.variableRetention γ r ∈ Set.Icc 0 1) →
                            ∀ (x : RectangleCLT.Vector p) {t : ℝ},
                              0 < t →
                                t < 1 →
                                  ContinuousAt γ' t →
                                    HasDerivAt
                                      (fun r =>
                                        ∫ (y : RectangleCLT.Vector p),
                                          F
                                            (x +
                                              y) ∂RectangleCLT.Companion.SplitV4.variableSeededInterpolationLaw μ ξ A γ
                                            ε r)
                                      ((-γ t + (1 - t) * γ' t) / 6 *
                                          ∫ (y : RectangleCLT.Vector p),
                                            RectangleCLT.Companion.SplitV4.canonicalSignedCubicContraction μ F ξ
                                              (x +
                                                y) ∂RectangleCLT.Companion.SplitV4.variableSeededInterpolationLaw μ ξ A
                                              γ ε t +
                                        ∫ (r : ℝ) in 0 ..1,
                                          RectangleCLTArxivV1.seededInterpolationFourthPath μ
                                            (RectangleCLT.gaussianLaw A) F ξ x
                                            (RectangleCLT.Companion.SplitV4.variableRetention γ t) (γ t) (√(t + ε))
                                            (RectangleCLT.Companion.SplitV4.variableEta γ γ' t) t r)
                                      t
