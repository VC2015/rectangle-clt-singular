RectangleCLTArxivV1.lowerFamilyMasterRemainder_nonneg : ∀ (P : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters)
  {r m n : ℕ} [inst : NeZero m], 1 ≤ r → 0 ≤ RectangleCLTArxivV1.lowerFamilyMasterRemainder P n r m
RectangleCLTArxivV1.lowerFamilyMasterRemainder_width_bound : ∀
  (P : RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters) {n r m : ℕ} [inst : NeZero m] {c : ℝ},
  0 < c →
    1 ≤ n →
      1 ≤ r →
        r ≤ m →
          1 ≤ Real.log ↑m →
            1 ≤ P.amplitude →
              c * √(RectangleCLT.dimensionLog r) ≤ RectangleCLTArxivV1.independentAbsGaussianMean r →
                P.pi = 1 →
                  ↑n * P.theta = Real.log ↑m / 2 →
                    RectangleCLTArxivV1.lowerFamilyMasterRemainder P n r m ≤
                      (RectangleCLTArxivV1.lowerRademacherMaximumConstant / c / Real.log ↑m +
                          (2 * RectangleCLTArxivV1.lowerRademacherMaximumConstant +
                              RectangleCLTArxivV1.lowerGaussianCurvatureConstant * (3 + 4 * Real.exp (11 / 2)) / 2) *
                            (RectangleCLTArxivV1.lowerFamilyWidthScale P n r m / c ^ 2)) *
                        RectangleCLTArxivV1.lowerFamilyWidthScale P n r m
