@RectangleCLTArxivV1.tendsto_lower_bounded_raw_width_scale : ∀ {B : ℕ → ℝ} {r m : ℕ → ℕ},
  (∀ (n : ℕ), 2 ≤ B n) →
    (∀ (n : ℕ), 1 ≤ r n) →
      (∀ (n : ℕ), 2 ≤ m n) →
        Filter.Tendsto
            (fun n =>
              B n * RectangleCLTArxivV1.independentAbsGaussianMean (r n) * RectangleCLT.dimensionLog (r n * m n) / √↑n)
            Filter.atTop (nhds 0) →
          Filter.Tendsto
            (fun n =>
              RectangleCLTArxivV1.lowerWidthScale (B n - 1) (Real.log ↑(m n))
                (RectangleCLTArxivV1.independentAbsGaussianMean (r n)) ↑n)
            Filter.atTop (nhds 0)
@RectangleCLTArxivV1.lower_bounded_target_le_twelve_scale : ∀ {B G g ell L N : ℝ},
  2 ≤ B →
    0 ≤ G →
      0 ≤ g →
        G ≤ 2 * g →
          0 ≤ ell → 0 ≤ L → L ≤ 3 * ell → B * G * L / √N ≤ 12 * RectangleCLTArxivV1.lowerWidthScale (B - 1) ell g N
