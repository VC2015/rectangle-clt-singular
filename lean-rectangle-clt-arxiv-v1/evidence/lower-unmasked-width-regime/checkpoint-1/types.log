RectangleCLTArxivV1.exists_lowerFamily_unmasked_signed_detection_constant : ∃ c,
  0 < c ∧
    ∀ (P : ℕ → RectangleCLT.Companion.SplitV4.SymmetricFamilyParameters) (r m : ℕ → ℕ) [inst : ∀ (n : ℕ), NeZero (r n)]
      [inst_1 : ∀ (n : ℕ), NeZero (m n)],
      (∀ (n : ℕ), 1 ≤ r n) →
        (∀ (n : ℕ), 2 ≤ m n) →
          Filter.Tendsto m Filter.atTop Filter.atTop →
            (∀ᶠ (n : ℕ) in Filter.atTop, ↑n * (P n).theta = Real.log ↑(m n) / 2) →
              (∀ᶠ (n : ℕ) in Filter.atTop, (P n).pi = 1) →
                Filter.Tendsto (fun n => (P n).variance) Filter.atTop (nhds 0) →
                  (∀ᶠ (n : ℕ) in Filter.atTop,
                      RectangleCLT.dimensionLog (r n) ≤
                        RectangleCLT.Companion.SplitV4.Printed.rademacherGlobalSmallConstant * √↑n) →
                    Filter.Tendsto
                        (fun n =>
                          RectangleCLTArxivV1.lowerFamilyMasterRemainder (P n) n (r n) (m n) /
                            RectangleCLTArxivV1.lowerFamilyWidthScale (P n) n (r n) (m n))
                        Filter.atTop (nhds 0) →
                      ∀ᶠ (n : ℕ) in Filter.atTop,
                        c * RectangleCLTArxivV1.lowerFamilyWidthScale (P n) n (r n) (m n) ≤
                          RectangleCLTArxivV1.lowerFamilyShiftedCDFDifference (P n) n (r n) (m n)
                            (RectangleCLTArxivV1.lowerLeadingThreshold (r n))
