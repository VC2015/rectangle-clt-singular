RectangleCLTArxivV1.theorem_6_growing_fourth_moment_lower : ∃ c,
  0 < c ∧
    ∀ (B : ℕ → ℝ) (r m : ℕ → ℕ) [inst : ∀ (n : ℕ), NeZero (r n)] [inst_1 : ∀ (n : ℕ), NeZero (m n)],
      (∀ (n : ℕ), 2 ≤ B n) →
        (∀ (n : ℕ), 1 ≤ r n) →
          (∀ (n : ℕ), 2 ≤ m n) →
            (∀ (n : ℕ), r n ≤ m n) →
              Filter.Tendsto m Filter.atTop Filter.atTop →
                Filter.Tendsto B Filter.atTop Filter.atTop →
                  Filter.Tendsto (fun n => Real.log (B n) / RectangleCLT.dimensionLog (r n * m n)) Filter.atTop
                      (nhds 0) →
                    Filter.Tendsto
                        (fun n =>
                          RectangleCLTArxivV1.lowerMaskedFourthIntrinsicRate n (RectangleCLT.dimensionLog (r n * m n))
                            (B n) (RectangleCLTArxivV1.independentAbsGaussianMean (r n)))
                        Filter.atTop (nhds 0) →
                      Filter.Tendsto
                          (fun n =>
                            RectangleCLTArxivV1.gaussianMaximumMean
                                (RectangleCLTArxivV1.lowerFamilyGaussianFactor
                                  (RectangleCLTArxivV1.lowerMaskedFourthSequence B m n) (r n) (m n)) /
                              RectangleCLTArxivV1.independentAbsGaussianMean (r n))
                          Filter.atTop (nhds 1) ∧
                        ∀ᶠ (n : ℕ) in Filter.atTop,
                          RectangleCLTArxivV1.LowerRectangularFamilyProperties
                              (RectangleCLTArxivV1.lowerMaskedFourthSequence B m n) n (r n) (m n) ∧
                            RectangleCLTArxivV1.PolynomialFourthHypotheses
                                (RectangleCLTArxivV1.lowerFamilyArrayLaw
                                  (RectangleCLTArxivV1.lowerMaskedFourthSequence B m n) n (r n) (m n))
                                (RectangleCLTArxivV1.lowerFamilyRawObservations
                                  (RectangleCLTArxivV1.lowerMaskedFourthSequence B m n))
                                4 (B n) ∧
                              c *
                                    RectangleCLTArxivV1.lowerMaskedFourthIntrinsicRate n
                                      (RectangleCLT.dimensionLog (r n * m n)) (B n)
                                      (RectangleCLTArxivV1.gaussianMaximumMean
                                        (RectangleCLTArxivV1.lowerFamilyGaussianFactor
                                          (RectangleCLTArxivV1.lowerMaskedFourthSequence B m n) (r n) (m n))) ≤
                                  -RectangleCLTArxivV1.lowerFamilyShiftedCDFDifference
                                      (RectangleCLTArxivV1.lowerMaskedFourthSequence B m n) n (r n) (m n)
                                      (RectangleCLTArxivV1.lowerLeadingThreshold (r n)) ∧
                                c *
                                    RectangleCLTArxivV1.lowerMaskedFourthIntrinsicRate n
                                      (RectangleCLT.dimensionLog (r n * m n)) (B n)
                                      (RectangleCLTArxivV1.gaussianMaximumMean
                                        (RectangleCLTArxivV1.lowerFamilyGaussianFactor
                                          (RectangleCLTArxivV1.lowerMaskedFourthSequence B m n) (r n) (m n))) ≤
                                  RectangleCLTArxivV1.lowerFamilyComparisonDistance
                                    (RectangleCLTArxivV1.lowerMaskedFourthSequence B m n) n (r n) (m n)
