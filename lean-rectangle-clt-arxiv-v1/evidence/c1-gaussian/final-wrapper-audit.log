@RectangleCLTArxivV1.activeCoordinateNormals_covariance_diagonal : ∀ {p : ℕ} (s : RectangleCLT.FaceSmoother p)
  (Q : Matrix (Fin p) (Fin p) ℝ) (v : ℝ),
  (∀ (j : Fin p), Q j j = v) →
    ∀ (j : Fin s.faces.card),
      RectangleCLTArxivV1.activeCoordinateNormals s j ⬝ᵥ Q.mulVec (RectangleCLTArxivV1.activeCoordinateNormals s j) = v
@RectangleCLTArxivV1.gaussianRectangleBoundary_intrinsic_fixed_shift : ∀ {p : ℕ} (s : RectangleCLT.FaceSmoother p)
  (G : Matrix (Fin p) (Fin p) ℝ) (b : RectangleCLT.Vector p) {v d : ℝ},
  0 < v →
    0 < d →
      (∀ (j : Fin p), (G * G.transpose) j j = v) →
        (RectangleCLT.gaussianLaw G).real {x | x + b ∈ s.boundaryLayer d} ≤
          2 * d / v * RectangleCLTArxivV1.gaussianMaximumMean G
@RectangleCLTArxivV1.gaussianRectangleBoundary_intrinsic_product : ∀ {E : Type u_1} [inst : MeasurableSpace E] {p : ℕ}
  (s : RectangleCLT.FaceSmoother p) (G : Matrix (Fin p) (Fin p) ℝ) (τ : MeasureTheory.Measure E)
  [inst_1 : MeasureTheory.IsProbabilityMeasure τ] (R : E → RectangleCLT.Vector p),
  Measurable R →
    ∀ (b : RectangleCLT.Vector p) {v d : ℝ},
      0 < v →
        0 < d →
          (∀ (j : Fin p), (G * G.transpose) j j = v) →
            ((RectangleCLT.gaussianLaw G).prod τ).real {z | z.1 + R z.2 + b ∈ s.boundaryLayer d} ≤
              2 * d / v * RectangleCLTArxivV1.gaussianMaximumMean G
