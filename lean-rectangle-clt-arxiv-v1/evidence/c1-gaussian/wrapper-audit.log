@RectangleCLTArxivV1.gaussianUnitRowsBoundary_printed : ∀ {m r : ℕ} [inst : NeZero m]
  (w : Fin m → RectangleCLT.Vector r) (a : Fin m → ℝ),
  (∀ (α : Fin m), RectangleCLT.vectorNormSq (w α) = 1) →
    ∀ {s : ℝ},
      0 < s →
        (RectangleCLT.standardGaussian r).real
            {x |
              -s ≤ RectangleCLT.Companion.SplitV4.gaussianAffineMaximum w a x ∧
                RectangleCLT.Companion.SplitV4.gaussianAffineMaximum w a x ≤ s} ≤
          2 * s *
            ∫ (x : RectangleCLT.Vector r),
              RectangleCLT.Companion.SplitV4.positiveGaussianFaceMaximum w x ∂RectangleCLT.standardGaussian r
@RectangleCLTArxivV1.gaussianUnitRowsMaximum_logarithmic : ∀ {m r : ℕ} [inst : NeZero m]
  (w : Fin m → RectangleCLT.Vector r),
  (∀ (α : Fin m), RectangleCLT.vectorNormSq (w α) = 1) →
    ∫ (x : RectangleCLT.Vector r),
        RectangleCLT.Companion.SplitV4.positiveGaussianFaceMaximum w x ∂RectangleCLT.standardGaussian r ≤
      √(2 * Real.log (↑m + 1))
@RectangleCLTArxivV1.gaussianIntrinsicBoundary_fixed_shift : ∀ {p m : ℕ} [inst : NeZero m]
  (ν : Matrix (Fin m) (Fin p) ℝ) (A : Matrix (Fin p) (Fin p) ℝ) (a : RectangleCLT.Vector m) (b : RectangleCLT.Vector p)
  {v s : ℝ},
  0 < v →
    0 < s →
      (∀ (α : Fin m), ν α ⬝ᵥ (A * A.transpose).mulVec (ν α) = v) →
        (RectangleCLT.gaussianLaw A).real {x | x + b ∈ RectangleCLT.Companion.SplitV4.gaussianPolyhedronLayer ν a s} ≤
          min 1 (2 * s / v * ∫ (x : RectangleCLT.Vector p), ‖ν.mulVec x‖ ∂RectangleCLT.gaussianLaw A)
@RectangleCLTArxivV1.gaussianIntrinsicBoundary_product : ∀ {p m : ℕ} [inst : NeZero m] (ν : Matrix (Fin m) (Fin p) ℝ)
  (A : Matrix (Fin p) (Fin p) ℝ) (τ : MeasureTheory.Measure (RectangleCLT.Vector p))
  [inst : MeasureTheory.IsProbabilityMeasure τ] (a : RectangleCLT.Vector m) {v s : ℝ},
  0 < v →
    0 < s →
      (∀ (α : Fin m), ν α ⬝ᵥ (A * A.transpose).mulVec (ν α) = v) →
        ((RectangleCLT.gaussianLaw A).prod τ).real
            {z | z.1 + z.2 ∈ RectangleCLT.Companion.SplitV4.gaussianPolyhedronLayer ν a s} ≤
          min 1 (2 * s / v * ∫ (x : RectangleCLT.Vector p), ‖ν.mulVec x‖ ∂RectangleCLT.gaussianLaw A)
@RectangleCLTArxivV1.gaussianIntrinsicBoundary_independent_shift : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [inst_1 : MeasureTheory.IsProbabilityMeasure μ] {p m : ℕ} [inst_2 : NeZero m]
  (V R : Ω → RectangleCLT.Vector p),
  Measurable V →
    Measurable R →
      ProbabilityTheory.IndepFun V R μ →
        ∀ (ν : Matrix (Fin m) (Fin p) ℝ) (A : Matrix (Fin p) (Fin p) ℝ),
          MeasureTheory.Measure.map V μ = RectangleCLT.gaussianLaw A →
            ∀ (a : RectangleCLT.Vector m) {v s : ℝ},
              0 < v →
                0 < s →
                  (∀ (α : Fin m), ν α ⬝ᵥ (A * A.transpose).mulVec (ν α) = v) →
                    μ.real {ω | V ω + R ω ∈ RectangleCLT.Companion.SplitV4.gaussianPolyhedronLayer ν a s} ≤
                      min 1 (2 * s / v * ∫ (ω : Ω), ‖ν.mulVec (V ω)‖ ∂μ)
@RectangleCLTArxivV1.gaussianFaceLayer_bound : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [inst_1 : MeasureTheory.IsProbabilityMeasure μ] {p m : ℕ} [inst_2 : NeZero m] (V R : Ω → RectangleCLT.Vector p),
  Measurable V →
    Measurable R →
      ProbabilityTheory.IndepFun V R μ →
        ∀ (U : Fin m → RectangleCLT.Vector p) (A : Matrix (Fin p) (Fin p) ℝ),
          MeasureTheory.Measure.map V μ = RectangleCLT.gaussianLaw A →
            ∀ (a : RectangleCLT.Vector m) {v s : ℝ},
              0 < v →
                0 < s →
                  (∀ (α : Fin m), U α ⬝ᵥ (A * A.transpose).mulVec (U α) = v) →
                    μ.real {ω | V ω + R ω ∈ RectangleCLTArxivV1.faceLayer U a s} ≤
                      min 1 (2 * s / v * ∫ (ω : Ω), RectangleCLTArxivV1.faceNorm U (V ω) ∂μ)
RectangleCLTArxivV1.gaussianUnitRowsBoundary_printed uses [propext, Quot.sound, Classical.choice]
RectangleCLTArxivV1.gaussianUnitRowsMaximum_logarithmic uses [propext, Quot.sound, Classical.choice]
RectangleCLTArxivV1.gaussianIntrinsicBoundary_fixed_shift uses [propext, Quot.sound, Classical.choice]
RectangleCLTArxivV1.gaussianIntrinsicBoundary_product uses [propext, Quot.sound, Classical.choice]
RectangleCLTArxivV1.gaussianIntrinsicBoundary_independent_shift uses [propext, Quot.sound, Classical.choice]
RectangleCLTArxivV1.gaussianFaceLayer_bound uses [propext, Quot.sound, Classical.choice]
