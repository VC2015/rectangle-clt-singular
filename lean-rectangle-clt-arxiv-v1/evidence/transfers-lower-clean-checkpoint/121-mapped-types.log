RectangleCLTArxivV1.lemma_C2_expected_maximum : ∃ C,
  0 < C ∧
    ∀ (Ω : Type u_1) [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
      [inst_1 : MeasureTheory.IsProbabilityMeasure μ] (p n : ℕ),
      1 ≤ p →
        1 ≤ n →
          ∀ (ξ : Fin n → Ω → RectangleCLT.Vector p) (δ : ℝ),
            (∀ (i : Fin n), Measurable (ξ i)) →
              ProbabilityTheory.iIndepFun ξ μ →
                (∀ (i : Fin n) (j : Fin p), ∫ (ω : Ω), ξ i ω j ∂μ = 0) →
                  (∀ (i : Fin n), ∀ᵐ (ω : Ω) ∂μ, ‖ξ i ω‖ ≤ δ) →
                    (∀ (j : Fin p), RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) j j = 1) →
                      ∀ (A : Matrix (Fin p) (Fin p) ℝ),
                        A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) →
                          ∫ (ω : Ω), ‖RectangleCLT.sumVector ξ ω‖ ∂μ ≤
                            C * (RectangleCLTArxivV1.gaussianMaximumMean A + δ * RectangleCLT.dimensionLog p)
