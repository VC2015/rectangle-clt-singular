            A * A.transpose = RectangleCLT.covariance μ (RectangleCLT.sumVector ξ) →
              let κ := RectangleCLTArxivV1.intrinsicBoundaryCoefficient μ ξ A;
              ∀ (s : RectangleCLT.FaceSmoother p),
                s.faces = Finset.univ →
                  A₀ * δ ≤ s.bandwidth →
                    (∀ v ∈ Set.Ioo 0 1,
                        |RectangleCLT.Companion.SplitV4.directSlepianCubicTerm s μ ξ A v| ≤
                            C * s₃ * κ / s.bandwidth ^ 2 ∧
                          |RectangleCLT.Companion.SplitV4.directSlepianFourthRemainder s μ ξ A v| ≤
                            C * s₄ * κ / s.bandwidth ^ 3) ∧
                      (RectangleCLT.dimensionLog p * s.bandwidth ^ 2 < 1 / 4 →
                        RectangleCLT.Companion.SplitV4.initializationDiscrepancy μ ξ A s.bandwidth ⋯ ≤
                            C * s₃ * (RectangleCLT.dimensionLog p * κ) +
                              C * s₄ * (RectangleCLT.dimensionLog p * κ) / s.bandwidth ∧
                          let ε := RectangleCLT.dimensionLog p * s.bandwidth ^ 2;
                          let hp := ⋯;
                          let hε := ⋯;
                          ∀ t ∈ Set.Ioo 0 1,
                            HasDerivAt (RectangleCLT.Companion.SplitV4.normalizedSeededExpectation s μ ξ A ε)
                                (-(t / (3 * (1 + ε) ^ (3 / 2))) *
                                    RectangleCLT.Companion.SplitV4.normalizedSeededCubicTerm s μ ξ A ε t +
                                  RectangleCLT.Companion.SplitV4.normalizedSeededFourthRemainder s μ ξ A ε hε t)
                                t ∧
                              |t / (3 * (1 + ε) ^ (3 / 2)) *
                                      RectangleCLT.Companion.SplitV4.normalizedSeededCubicTerm s μ ξ A ε t| ≤
                                  C * s₃ * (RectangleCLT.dimensionLog p * κ) * t / (t + ε) ∧
                                |RectangleCLT.Companion.SplitV4.normalizedSeededFourthRemainder s μ ξ A ε hε t| ≤
                                  C * s₄ * (RectangleCLT.dimensionLog p * κ) / (s.bandwidth * (t + ε)))
