    0 < σ ^ 2 →
      (∀ (α : Fin m) (i : Fin n), |B α i| ≤ b) →
        (∀ (α : Fin m), σ ^ 2 ≤ ∑ i, B α i ^ 2) →
          (RectangleCLT.Companion.SplitV4.cubeUniformLaw n).real
              {x |
                t ≤ RectangleCLT.Companion.SplitV4.affineCubeMaximum B a x ∧
                  RectangleCLT.Companion.SplitV4.affineCubeMaximum B a x ≤ t + h} ≤
            (h + 8 * b) / σ ^ 2 *
              ∫ (x : Kane.Cube n),
                RectangleCLT.Companion.SplitV4.positiveLinearMaximum B
                  x ∂RectangleCLT.Companion.SplitV4.cubeUniformLaw n
@RectangleCLTArxivV1.lemma_C1_rademacher_maximum : ∀ {m n : ℕ} (B : Fin m → Fin n → ℝ),
  (∀ (α : Fin m), ∑ i, B α i ^ 2 ≤ 1) →
    ∫ (x : Kane.Cube n),
        RectangleCLT.Companion.SplitV4.positiveLinearMaximum B x ∂RectangleCLT.Companion.SplitV4.cubeUniformLaw n ≤
      √(2 * Real.log (↑m + 1))
@RectangleCLTArxivV1.gaussianEndpointSmoothing_intrinsic : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {p : ℕ},
  1 ≤ p →
    ∀ (μ : MeasureTheory.Measure Ω) [inst_1 : MeasureTheory.IsProbabilityMeasure μ] (V : Ω → RectangleCLT.Vector p),
      Measurable V →
        ∀ (A : Matrix (Fin p) (Fin p) ℝ),
          (∀ (j : Fin p), (A * A.transpose) j j = 1) →
            ∀ (h : ℝ) (hh : 0 < h),
              RectangleCLT.Companion.rectangleDistance μ V A ≤
                RectangleCLTArxivV1.intrinsicGaussianSmoothingConstant *
                  (RectangleCLT.Companion.SplitV4.smoothingDiscrepancy μ V A h hh +
                    h * RectangleCLTArxivV1.gaussianMaximumMean A * RectangleCLT.dimensionLog p)
